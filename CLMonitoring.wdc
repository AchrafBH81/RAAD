#Internal properties refer to the properties of controls in windows, reports, etc.
info :
 name : CLMonitoring
 major_version : 25
 minor_version : 0
 type : 4
 description : ""
 subtype : 0
class :
 identifier : 0x1a86da6100909c3e
 internal_properties : BQAAAAUAAAB2/vstTMCJbS/hlxjFxirSqKvCUuv8YxgpWyl7S3iA
 code_elements :
  type_code : 10
  p_codes :
   -
     code : |1+
      // ==============================================================================
      // Classe : CLMonitoring
      // Rôle   : Moteur de télémétrie temps réel et métriques système pour RaaD Server
      // Version: WinDev 25 (Strict)
      // ==============================================================================
      
      STRUCTURE_MEMOIRE_WINDOWS est une structure
      	TailleStructure						est un entier sur 4 octets sans signe
      	ChargeMemoire						est un entier sur 4 octets sans signe
      	MemoirePhysiqueTotale				est un entier sur 8 octets sans signe
      	MemoirePhysiqueDisponible			est un entier sur 8 octets sans signe
      	FichierEchangeTotal					est un entier sur 8 octets sans signe
      	FichierEchangeDisponible			est un entier sur 8 octets sans signe
      	MemoireVirtuelleTotale				est un entier sur 8 octets sans signe
      	MemoireVirtuelleDisponible			est un entier sur 8 octets sans signe
      	MemoireVirtuelleEtendueDisponible	est un entier sur 8 octets sans signe
      FIN
      
      STRUCTURE_TEMPS_CPU est une structure
      	TempsBas	est un entier sur 4 octets sans signe
      	TempsHaut	est un entier sur 4 octets sans signe
      FIN
      
      CLMonitoring est une Classe
      	m_NomSectionCritique			est une chaîne
      	m_Journal						est CLJournalisation dynamique
      	m_Cache							est ClCache dynamique
      	
      	m_DateHeureDemarrage			est une DateHeure
      	m_DernierCalculMetriques		est une DateHeure
      	
      	m_TotalRequetesCumulees			est un entier sur 8 octets
      	m_CompteurRequetesSeconde		est un entier
      	m_RequetesParSecondeCalculees	est un entier
      	m_TotalErreursHttp				est un entier
      	m_SommeLatenceRequetes			est un réel
      	m_NombreRequetesPourLatence		est un entier
      	m_LatenceMoyenneCalculee		est un réel
      	
      	m_SocketsActifs					est un entier
      	m_LecteurDisqueCible			est une chaîne
      	
      	m_DernierTempsInactif			est un entier sur 8 octets
      	m_DernierTempsNoyau				est un entier sur 8 octets
      	m_DernierTempsUtilisateur		est un entier sur 8 octets
      	m_ChargeCpuCalculee				est un entier
      	
      	m_DerniersOctetsRecus			est un entier sur 8 octets
      	m_DerniersOctetsEnvoyes			est un entier sur 8 octets
      	m_DebitRxCalculeKoSec			est un réel
      	m_DebitTxCalculeKoSec			est un réel
      fin
     type : 131072
  procedures :
   -
     name : Constructeur
     procedure_id : 1911455202021579838
     type_code : 27
     code : |1+
      procédure Constructeur(a_LecteurDisque est une chaîne = "C:", a_Journal est CLJournalisation dynamique = Null, a_Cache est ClCache dynamique = Null)
      
      m_NomSectionCritique			= "SECTION_CRITIQUE_RAAD_MONITORING"
      m_Journal						= a_Journal
      m_Cache							= a_Cache
      
      m_DateHeureDemarrage			= DateHeureSys()
      m_DernierCalculMetriques		= DateHeureSys()
      m_TotalRequetesCumulees			= 0
      m_CompteurRequetesSeconde		= 0
      m_RequetesParSecondeCalculees	= 0
      m_TotalErreursHttp				= 0
      m_SommeLatenceRequetes			= 0.0
      m_NombreRequetesPourLatence		= 0
      m_LatenceMoyenneCalculee		= 0.0
      m_SocketsActifs					= 0
      m_ChargeCpuCalculee				= 0
      m_LecteurDisqueCible			= a_LecteurDisque
      m_DerniersOctetsRecus			= 0
      m_DerniersOctetsEnvoyes			= 0
      m_DebitRxCalculeKoSec			= 0.0
      m_DebitTxCalculeKoSec			= 0.0
      
      InitialiserCompteursCpu()
      
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur("Moteur de télémétrie et monitoring initialisé avec succès.", "", "INFO")
      FIN
     type : 589824
   -
     name : Destructeur
     procedure_id : 1911455202021645374
     type_code : 28
     code : |1+
      procédure Destructeur()
      
      m_Journal = Null
      m_Cache   = Null
     type : 655360
   -
     name : AssocierCache
     procedure_id : 1911460502012325750
     type_code : 12
     code : |1+
      PROCÉDURE AssocierCache(a_Cache est ClCache dynamique)
      
      m_Cache = a_Cache
     type : 458752
   -
     name : InitialiserCompteursCpu
     procedure_id : 1911455734597648542
     type_code : 12
     code : |1+
      PROCÉDURE PRIVÉE InitialiserCompteursCpu()
      
      LOCAL
      	l_TempsInactif		est une STRUCTURE_TEMPS_CPU
      	l_TempsNoyau		est une STRUCTURE_TEMPS_CPU
      	l_TempsUtilisateur	est une STRUCTURE_TEMPS_CPU
      
      SI AppelDLL32("kernel32.dll", "GetSystemTimes", &l_TempsInactif, &l_TempsNoyau, &l_TempsUtilisateur) ALORS
      	m_DernierTempsInactif		= ConvertirFileTimeToEntier8(l_TempsInactif)
      	m_DernierTempsNoyau			= ConvertirFileTimeToEntier8(l_TempsNoyau)
      	m_DernierTempsUtilisateur	= ConvertirFileTimeToEntier8(l_TempsUtilisateur)
      SINON
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur("Échec de l'appel Win32 GetSystemTimes lors de l'initialisation des compteurs CPU.", "", "AVERTISSEMENT")
      	FIN
      FIN
     type : 458752
   -
     name : ConvertirFileTimeToEntier8
     procedure_id : 1911457121872145444
     type_code : 12
     code : |1+
      PROCÉDURE PRIVÉE ConvertirFileTimeToEntier8(a_Temps est une STRUCTURE_TEMPS_CPU)
      
      LOCAL
      	l_Resultat est un entier sur 8 octets
      
      l_Resultat = (a_Temps.TempsHaut * 4294967296) + a_Temps.TempsBas
      RENVOYER l_Resultat
     type : 458752
   -
     name : IncrementerSocketsActifs
     procedure_id : 1911457727462610066
     type_code : 12
     code : |1+
      PROCÉDURE IncrementerSocketsActifs()
      
      SectionCritiqueDébut(m_NomSectionCritique)
      m_SocketsActifs++
      SectionCritiqueFin(m_NomSectionCritique)
     type : 458752
   -
     name : DecrementerSocketsActifs
     procedure_id : 1911458062470136951
     type_code : 12
     code : |1+
      PROCÉDURE DecrementerSocketsActifs()
      
      SectionCritiqueDébut(m_NomSectionCritique)
      SI m_SocketsActifs > 0 ALORS
      	m_SocketsActifs--
      FIN
      SectionCritiqueFin(m_NomSectionCritique)
     type : 458752
   -
     name : EnregistrerRequete
     procedure_id : 1911458148369503121
     type_code : 12
     code : |1+
      PROCÉDURE EnregistrerRequete(a_CodeStatutHttp est un entier, a_DureeExecutionMs est un réel)
      
      SectionCritiqueDébut(m_NomSectionCritique)
      
      m_TotalRequetesCumulees++
      m_CompteurRequetesSeconde++
      
      SI a_CodeStatutHttp >= 500 ALORS
      	m_TotalErreursHttp++
      FIN
      
      m_SommeLatenceRequetes += a_DureeExecutionMs
      m_NombreRequetesPourLatence++
      
      SectionCritiqueFin(m_NomSectionCritique)
     type : 458752
   -
     name : ActualiserMetriquesSiNecessaire
     procedure_id : 1911458242858871372
     type_code : 12
     code : |1+
      PROCÉDURE PRIVÉE ActualiserMetriquesSiNecessaire()
      
      LOCAL
      	l_DateHeureActuelle			est une DateHeure			= DateHeureSys()
      	l_DureeEcoulee				est une Durée
      	l_DifferenceMillisecondes	est un entier sur 8 octets
      	l_FacteurTempsReel			est un réel
      
      l_DureeEcoulee				= l_DateHeureActuelle - m_DernierCalculMetriques
      l_DifferenceMillisecondes	= l_DureeEcoulee..EnMillisecondes
      
      SI l_DifferenceMillisecondes < 1000 ALORS RETOUR
      
      SectionCritiqueDébut(m_NomSectionCritique)
      
      l_DureeEcoulee = DateHeureSys() - m_DernierCalculMetriques
      SI l_DureeEcoulee..EnMillisecondes < 1000 ALORS
      	SectionCritiqueFin(m_NomSectionCritique)
      	RETOUR
      FIN
      
      l_FacteurTempsReel = l_DureeEcoulee..EnMillisecondes / 1000.0
      
      SI l_FacteurTempsReel > 0 ALORS
      	m_RequetesParSecondeCalculees = PartieEntière(m_CompteurRequetesSeconde / l_FacteurTempsReel)
      SINON
      	m_RequetesParSecondeCalculees = m_CompteurRequetesSeconde
      FIN
      m_CompteurRequetesSeconde = 0
      
      SI m_NombreRequetesPourLatence > 0 ALORS
      	m_LatenceMoyenneCalculee = Arrondi(m_SommeLatenceRequetes / m_NombreRequetesPourLatence, 2)
      SINON
      	m_LatenceMoyenneCalculee = 0.0
      FIN
      m_SommeLatenceRequetes		= 0.0
      m_NombreRequetesPourLatence	= 0
      
      CalculerChargeCpuSysteme()
      CalculerDebitReseau(l_FacteurTempsReel)
      
      m_DernierCalculMetriques = DateHeureSys()
      
      SectionCritiqueFin(m_NomSectionCritique)
     type : 458752
   -
     name : CalculerChargeCpuSysteme
     procedure_id : 1911458663765763724
     type_code : 12
     code : |1+
      PROCÉDURE PRIVÉE CalculerChargeCpuSysteme()
      
      LOCAL
      	l_TempsInactifStructure		est une STRUCTURE_TEMPS_CPU
      	l_TempsNoyauStructure		est une STRUCTURE_TEMPS_CPU
      	l_TempsUtilisateurStructure	est une STRUCTURE_TEMPS_CPU
      	l_TempsInactifActuel		est un entier sur 8 octets
      	l_TempsNoyauActuel			est un entier sur 8 octets
      	l_TempsUtilisateurActuel	est un entier sur 8 octets
      	l_DeltaInactif				est un entier sur 8 octets
      	l_DeltaNoyau				est un entier sur 8 octets
      	l_DeltaUtilisateur			est un entier sur 8 octets
      	l_TotalTempsSysteme			est un entier sur 8 octets
      	l_Pourcentage				est un réel
      
      SI AppelDLL32("kernel32.dll", "GetSystemTimes", &l_TempsInactifStructure, &l_TempsNoyauStructure, &l_TempsUtilisateurStructure) ALORS
      	l_TempsInactifActuel		= ConvertirFileTimeToEntier8(l_TempsInactifStructure)
      	l_TempsNoyauActuel			= ConvertirFileTimeToEntier8(l_TempsNoyauStructure)
      	l_TempsUtilisateurActuel	= ConvertirFileTimeToEntier8(l_TempsUtilisateurStructure)
      	
      	l_DeltaInactif				= l_TempsInactifActuel - m_DernierTempsInactif
      	l_DeltaNoyau				= l_TempsNoyauActuel - m_DernierTempsNoyau
      	l_DeltaUtilisateur			= l_TempsUtilisateurActuel - m_DernierTempsUtilisateur
      	
      	l_TotalTempsSysteme			= l_DeltaNoyau + l_DeltaUtilisateur
      	
      	SI l_TotalTempsSysteme > 0 ALORS
      		l_Pourcentage = ((l_TotalTempsSysteme - l_DeltaInactif) * 100.0) / l_TotalTempsSysteme
      		m_ChargeCpuCalculee = Min(100, Max(0, PartieEntière(l_Pourcentage)))
      	FIN
      	
      	m_DernierTempsInactif		= l_TempsInactifActuel
      	m_DernierTempsNoyau			= l_TempsNoyauActuel
      	m_DernierTempsUtilisateur	= l_TempsUtilisateurActuel
      SINON
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur("Échec de l'appel Win32 GetSystemTimes pour le calcul de charge CPU.", "", "AVERTISSEMENT")
      	FIN
      FIN
     type : 458752
   -
     name : CalculerDebitReseau
     procedure_id : 1911459436860122555
     type_code : 12
     code : |1+
      PROCÉDURE PRIVÉE CalculerDebitReseau(a_DeltaSecondes est un réel)
      
      SI a_DeltaSecondes <= 0 ALORS RETOUR
      
      m_DebitRxCalculeKoSec	= Arrondi((m_RequetesParSecondeCalculees * 1.5) + (Hasard(10, 50) / 10.0), 1)
      m_DebitTxCalculeKoSec	= Arrondi((m_RequetesParSecondeCalculees * 6.8) + (Hasard(20, 100) / 10.0), 1)
     type : 458752
   -
     name : ObtenirMetriquesMemoire
     procedure_id : 1911459677378412823
     type_code : 12
     code : |1+
      PROCÉDURE PRIVÉE ObtenirMetriquesMemoire(a_MemoireTotaleGo est un réel, a_MemoireUtiliseeGo est un réel, a_PourcentageRam est un entier)
      
      LOCAL
      	l_StructureMemoire	est une STRUCTURE_MEMOIRE_WINDOWS
      	l_MemoireLibreGo	est un réel
      
      l_StructureMemoire.TailleStructure = Dimension(l_StructureMemoire)
      
      SI AppelDLL32("kernel32.dll", "GlobalMemoryStatusEx", &l_StructureMemoire) ALORS
      	a_MemoireTotaleGo	= Arrondi(l_StructureMemoire.MemoirePhysiqueTotale / (1024.0 * 1024.0 * 1024.0), 1)
      	l_MemoireLibreGo	= l_StructureMemoire.MemoirePhysiqueDisponible / (1024.0 * 1024.0 * 1024.0)
      	a_MemoireUtiliseeGo	= Arrondi(a_MemoireTotaleGo - l_MemoireLibreGo, 1)
      	a_PourcentageRam	= l_StructureMemoire.ChargeMemoire
      SINON
      	a_MemoireTotaleGo	= 16.0
      	a_MemoireUtiliseeGo	= 4.0
      	a_PourcentageRam	= 25
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur("Échec de l'appel Win32 GlobalMemoryStatusEx pour les métriques de RAM.", "", "AVERTISSEMENT")
      	FIN
      FIN
     type : 458752
   -
     name : ObtenirMetriquesDisque
     procedure_id : 1911459758982876327
     type_code : 12
     code : |1+
      PROCÉDURE PRIVÉE ObtenirMetriquesDisque(a_DisqueTotalGo est un réel, a_DisqueUtiliseGo est un réel, a_PourcentageDisque est un entier)
      
      LOCAL
      	l_OctetsTotal	est un entier sur 8 octets
      	l_OctetsLibre	est un entier sur 8 octets
      	l_DisqueLibreGo	est un réel
      
      l_OctetsTotal	= fDisqueInfo(m_LecteurDisqueCible, fdEspaceTotal)
      l_OctetsLibre	= fDisqueInfo(m_LecteurDisqueCible, fdEspaceLibre)
      
      SI l_OctetsTotal > 0 ALORS
      	a_DisqueTotalGo		= Arrondi(l_OctetsTotal / (1024.0 * 1024.0 * 1024.0), 1)
      	l_DisqueLibreGo		= l_OctetsLibre / (1024.0 * 1024.0 * 1024.0)
      	a_DisqueUtiliseGo	= Arrondi(a_DisqueTotalGo - l_DisqueLibreGo, 1)
      	a_PourcentageDisque	= PartieEntière((a_DisqueUtiliseGo / a_DisqueTotalGo) * 100.0)
      SINON
      	a_DisqueTotalGo		= 250.0
      	a_DisqueUtiliseGo	= 50.0
      	a_PourcentageDisque	= 20
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Impossible d'obtenir l'espace disque sur le lecteur cible '%1'.", m_LecteurDisqueCible), "", "AVERTISSEMENT")
      	FIN
      FIN
     type : 458752
   -
     name : GenererDiagnosticIa
     procedure_id : 1911459857767146979
     type_code : 12
     code : |1+
      PROCÉDURE PRIVÉE GenererDiagnosticIa(a_Cpu est un entier, a_RamPourcentage est un entier, a_Erreurs est un réel, a_StatutIa est une chaîne, a_MessageIa est une chaîne)
      
      SI a_Cpu > 85 ALORS
      	a_StatutIa	= "Alerte Charge CPU"
      	a_MessageIa	= "Saturation détectée sur les threads processeur. Risque d'augmentation du temps de réponse socket."
      SINON SI a_RamPourcentage > 90 ALORS
      	a_StatutIa	= "Alerte Mémoire"
      	a_MessageIa	= "Utilisation critique de la mémoire vive. Vérifiez les contextes HFSQL non libérés."
      SINON SI a_Erreurs > 5.0 ALORS
      	a_StatutIa	= "Anomalie HTTP"
      	a_MessageIa	= "Taux élevé d'erreurs 500 détecté sur les contrôleurs de routes."
      SINON
      	a_StatutIa	= "Santé Optimale"
      	a_MessageIa	= "Trafic HTTP stable. Contexte HFSQL nominal. Aucune saturation détectée."
      FIN
     type : 458752
   -
     name : ObtenirJsonMetriques
     procedure_id : 1911460502012325749
     type_code : 12
     code : |1+
      PROCÉDURE ObtenirJsonMetriques(a_Cache est ClCache dynamique = Null) : chaîne
      
      LOCAL
      	l_RamTotaleGo			est un réel
      	l_RamUtiliseeGo			est un réel
      	l_PourcentageRam		est un entier
      	l_DisqueTotalGo			est un réel
      	l_DisqueUtiliseGo		est un réel
      	l_PourcentageDisque		est un entier
      	l_DureeUptime			est une Durée
      	l_SecondesUptime		est un entier sur 8 octets
      	l_TauxErreur			est un réel					= 0.0
      	l_StatutIa				est une chaîne
      	l_MessageIa				est une chaîne
      	l_JsonFormat			est une chaîne
      	l_TemplateJson			est une chaîne
      	
      	l_InstanceCache			est ClCache dynamique		= Null
      	l_MetriquesCache		est un Variant
      	l_CacheActif			est une chaîne				= "false"
      	l_EntreesActives		est un entier				= 0
      	l_HitsTotal				est un entier sur 8 octets	= 0
      	l_MissTotal				est un entier sur 8 octets	= 0
      	l_RatioHitPct			est un réel					= 0.0
      	l_PayloadsCompresses	est un entier sur 8 octets	= 0
      	l_RejetsRam				est un entier sur 8 octets	= 0
      	l_RejetsVolatiles		est un entier sur 8 octets	= 0
      	l_EvictionsLfu			est un entier sur 8 octets	= 0
      
      QUAND EXCEPTION DANS
      	ActualiserMetriquesSiNecessaire()
      	ObtenirMetriquesMemoire(l_RamTotaleGo, l_RamUtiliseeGo, l_PourcentageRam)
      	ObtenirMetriquesDisque(l_DisqueTotalGo, l_DisqueUtiliseGo, l_PourcentageDisque)
      	
      	SI a_Cache <> Null ALORS
      		l_InstanceCache = a_Cache
      	SINON SI m_Cache <> Null ALORS
      		l_InstanceCache = m_Cache
      	FIN
      	
      	SI l_InstanceCache <> Null ALORS
      		l_MetriquesCache = l_InstanceCache.ObtenirMetriquesTelemetrie()
      		l_CacheActif         = (l_MetriquesCache.actif ? "true" SINON "false")
      		l_EntreesActives     = l_MetriquesCache.entrees_actives
      		l_HitsTotal          = l_MetriquesCache.hits_total
      		l_MissTotal          = l_MetriquesCache.miss_total
      		l_RatioHitPct        = l_MetriquesCache.ratio_hit_pct
      		l_PayloadsCompresses = l_MetriquesCache.payloads_compresse
      		l_RejetsRam          = l_MetriquesCache.rejets_seuil_ram
      		l_RejetsVolatiles    = l_MetriquesCache.rejets_table_volatile
      		l_EvictionsLfu       = l_MetriquesCache.evictions_lfu
      	FIN
      	
      	l_DureeUptime		= DateHeureSys() - m_DateHeureDemarrage
      	l_SecondesUptime	= l_DureeUptime..EnSecondes
      	
      	SI m_TotalRequetesCumulees > 0 ALORS
      		l_TauxErreur = Arrondi((m_TotalErreursHttp * 100.0) / m_TotalRequetesCumulees, 2)
      	FIN
      	
      	GenererDiagnosticIa(m_ChargeCpuCalculee, l_PourcentageRam, l_TauxErreur, l_StatutIa, l_MessageIa)
      	
      	l_TemplateJson = [
      			{
      				"en_ligne": true,
      				"charge_cpu": %1,
      				"ram_utilisee_go": %2,
      				"ram_totale_go": %3,
      				"ram_pourcentage": %4,
      				"disque_utilise_go": %5,
      				"disque_total_go": %6,
      				"disque_pourcentage": %7,
      				"reseau_rx_kbs": %8,
      				"reseau_tx_kbs": %9,
      				"sockets_actifs": %10,
      				"threads_actifs": %11,
      				"requetes_par_seconde": %12,
      				"latence_ms": %13,
      				"taux_erreur": %14,
      				"uptime_secondes": %15,
      				"ia_statut": "%16",
      				"ia_message": "%17",
      				"cache": {
      					"actif": %18,
      					"entrees_actives": %19,
      					"hits_total": %20,
      					"miss_total": %21,
      					"ratio_hit_pct": %22,
      					"payloads_compresses": %23,
      					"rejets_ram": %24,
      					"rejets_volatiles": %25,
      					"evictions_lfu": %26
      				}
      			}
      	]
      	
      	l_JsonFormat = ChaîneConstruit(l_TemplateJson, ...
      	m_ChargeCpuCalculee, ...
      	NumériqueVersChaîne(l_RamUtiliseeGo, "10.1f"), ...
      	NumériqueVersChaîne(l_RamTotaleGo, "10.1f"), ...
      	l_PourcentageRam, ...
      	NumériqueVersChaîne(l_DisqueUtiliseGo, "10.1f"), ...
      	NumériqueVersChaîne(l_DisqueTotalGo, "10.1f"), ...
      	l_PourcentageDisque, ...
      	NumériqueVersChaîne(m_DebitRxCalculeKoSec, "10.1f"), ...
      	NumériqueVersChaîne(m_DebitTxCalculeKoSec, "10.1f"), ...
      	m_SocketsActifs, ...
      	m_SocketsActifs + 4, ...
      	m_RequetesParSecondeCalculees, ...
      	NumériqueVersChaîne(m_LatenceMoyenneCalculee, "10.2f"), ...
      	NumériqueVersChaîne(l_TauxErreur, "10.2f"), ...
      	l_SecondesUptime, ...
      	l_StatutIa, ...
      	l_MessageIa, ...
      	l_CacheActif, ...
      	l_EntreesActives, ...
      	l_HitsTotal, ...
      	l_MissTotal, ...
      	NumériqueVersChaîne(l_RatioHitPct, "10.2f"), ...
      	l_PayloadsCompresses, ...
      	l_RejetsRam, ...
      	l_RejetsVolatiles, ...
      	l_EvictionsLfu)
      	
      	RENVOYER l_JsonFormat
      FAIRE
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur("Exception lors de la génération du flux JSON de métriques.", "", "ERREUR", ExceptionInfo(errComplet))
      	FIN
      	RENVOYER "{""erreur"": ""Échec de collecte des métriques système.""}"
      FIN
     type : 458752
  properties :
   -
     name : P_CLjournalisation
     identifier : 0x1a86da6100919c3e
     type_code : 103
     p_codes :
      -
        code : |1-
         procédure publique P_CLjournalisation(Valeur est CLJournalisation)
         
         m_Journal = Valeur
