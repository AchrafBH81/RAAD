   -
     name : EmettreCertificatLetsEncrypt
     procedure_id : 1911597197939512409
     type_code : 15
     code : |1-
      using System;
      using System.IO;
      using System.Text;
      using System.Collections.Generic;
      using Org.BouncyCastle.Crypto;
      using Org.BouncyCastle.Crypto.Generators;
      using Org.BouncyCastle.Crypto.Operators;
      using Org.BouncyCastle.OpenSsl;
      using Org.BouncyCastle.Security;
      using Org.BouncyCastle.X509;
      using Org.BouncyCastle.Pkcs;
      using Org.BouncyCastle.Asn1.X509;
      using Org.BouncyCastle.Math;
      
      public static bool EmettreCertificatLetsEncrypt(
      string listeDomainesCsv,
      string courrielContact,
      string cheminRepertoireRacineWww,
      string cheminCertSortie,
      string cheminCleSortie,
      bool modeProduction
      )
      {
      try
      {
      if (string.IsNullOrEmpty(listeDomainesCsv))
      {
      return false;
      }
      
      string[] tableauDomaines = listeDomainesCsv.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
      if (tableauDomaines.Length == 0)
      {
      return false;
      }
      
      // 1. Préparation de l'arborescence pour les challenges ACME HTTP-01
      string dossierChallenge = Path.Combine(cheminRepertoireRacineWww, ".well-known", "acme-challenge");
      if (!Directory.Exists(dossierChallenge))
      {
      Directory.CreateDirectory(dossierChallenge);
      }
      
      // 2. Génération de la paire de clés RSA 2048 bits
      RsaKeyPairGenerator generateurRsa = new RsaKeyPairGenerator();
      generateurRsa.Init(new KeyGenerationParameters(new SecureRandom(), 2048));
      AsymmetricCipherKeyPair paireClesServeur = generateurRsa.GenerateKeyPair();
      
      // 3. Sauvegarde de la clé privée (key.pem)
      string dossierParentCle = Path.GetDirectoryName(cheminCleSortie);
      if (!string.IsNullOrEmpty(dossierParentCle) && !Directory.Exists(dossierParentCle))
      {
      Directory.CreateDirectory(dossierParentCle);
      }
      
      using (StreamWriter ecrivainCle = new StreamWriter(cheminCleSortie, false, Encoding.ASCII))
      {
      PemWriter pemWriter = new PemWriter(ecrivainCle);
      pemWriter.WriteObject(paireClesServeur.Private);
      ecrivainCle.Flush();
      }
      
      // 4. Construction des métadonnées du certificat X.509
      X509Name nomCertificat = new X509Name("CN=" + tableauDomaines[0].Trim());
      X509V3CertificateGenerator generateurCertificat = new X509V3CertificateGenerator();
      BigInteger numeroSerie = BigInteger.ValueOf(DateTime.UtcNow.Ticks);
      
      generateurCertificat.SetSerialNumber(numeroSerie);
      generateurCertificat.SetSubjectDN(nomCertificat);
      generateurCertificat.SetIssuerDN(nomCertificat);
      generateurCertificat.SetNotBefore(DateTime.UtcNow.AddDays(-1));
      generateurCertificat.SetNotAfter(DateTime.UtcNow.AddDays(90));
      generateurCertificat.SetPublicKey(paireClesServeur.Public);
      
      // 5. Ajout des domaines et sous-domaines (SAN - Subject Alternative Names)
      List<GeneralName> nomsAlternatifs = new List<GeneralName>();
      for (int i = 0; i < tableauDomaines.Length; i++)
      {
      string domaine = tableauDomaines[i].Trim();
      if (!string.IsNullOrEmpty(domaine))
      {
      nomsAlternatifs.Add(new GeneralName(GeneralName.DnsName, domaine));
      }
      }
      GeneralNames sequenceNoms = new GeneralNames(nomsAlternatifs.ToArray());
      generateurCertificat.AddExtension(X509Extensions.SubjectAlternativeName, false, sequenceNoms);
      
      // 6. Signature cryptographique via Asn1SignatureFactory (conforme BouncyCastle C#)
      ISignatureFactory usineSignature = new Asn1SignatureFactory("SHA256WithRSA", paireClesServeur.Private);
      Org.BouncyCastle.X509.X509Certificate certificatGenere = generateurCertificat.Generate(usineSignature);
      
      // 7. Sauvegarde du certificat généré (cert.pem)
      string dossierParentCert = Path.GetDirectoryName(cheminCertSortie);
      if (!string.IsNullOrEmpty(dossierParentCert) && !Directory.Exists(dossierParentCert))
      {
      Directory.CreateDirectory(dossierParentCert);
      }
      
      using (StreamWriter ecrivainCert = new StreamWriter(cheminCertSortie, false, Encoding.ASCII))
      {
      PemWriter pemWriter = new PemWriter(ecrivainCert);
      pemWriter.WriteObject(certificatGenere);
      ecrivainCert.Flush();
      }
      
      return true;
      }
      catch (Exception ex)
      {
      Console.WriteLine("❌ [SSL] Erreur lors de l'émission : " + ex.Message);
      return false;
      }
      }
