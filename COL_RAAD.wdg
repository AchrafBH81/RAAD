     name : ObtenirJoursRestantsCertificat
     procedure_id : 1911596923061541934
     type_code : 15
     code : |1-
      using System;
      using System.IO;
      using Org.BouncyCastle.OpenSsl;
      using Org.BouncyCastle.X509;
      
      public static int ObtenirJoursRestantsCertificat(string cheminCertPem)
      {
      try
      {
      if (string.IsNullOrEmpty(cheminCertPem) || !File.Exists(cheminCertPem))
      {
      return -1;
      }
      
      using (StreamReader lecteurFichier = File.OpenText(cheminCertPem))
      {
      PemReader lecteurPem = new PemReader(lecteurFichier);
      object objetCertificat = lecteurPem.ReadObject();
      
      if (objetCertificat is Org.BouncyCastle.X509.X509Certificate)
      {
      Org.BouncyCastle.X509.X509Certificate certificatBouncy = (Org.BouncyCastle.X509.X509Certificate)objetCertificat;
      DateTime dateExpiration = certificatBouncy.NotAfter;
      TimeSpan difference = dateExpiration - DateTime.UtcNow;
      return (int)difference.TotalDays;
      }
      }
      return -1;
      }
      catch (Exception)
      {
      return -1;
      }
      }
