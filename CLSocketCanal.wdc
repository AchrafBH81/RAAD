   -
     name : AnalyserRequete
     procedure_id : 1922791531976831648
     type_code : 12
     code : |1-
      PROCÉDURE AnalyserRequete()
      
      // Variables locales de repérage et de découpage structurel
      l_PositionSeparateur					est un entier
      l_TailleSeparateur						est un entier
      l_PremiereLigne							est un chaîne
      l_PositionSeparateurSchema				est un entier
      l_PositionPremierSlashApresHote			est un entier
      l_PositionPointInterrogationApresHote	est un entier
      l_PartieHote							est un chaîne
      l_PositionInterrogation					est un entier
      l_PositionFragment						est un entier
      l_UrlSansParametres						est un chaîne
      l_ValeurHote							est un chaîne
      l_ValeurUserAgent						est un chaîne
      l_AdresseIpTransferee					est un chaîne
      l_TailleContenuDeclaree					est un entier
      l_PositionAccoladeSecours				est un entier
      l_LigneEnTeteSecours					est un chaîne
      
      QUAND EXCEPTION DANS
      	
      	// ------------------------------------------------------------------------
      	// 1. RECHERCHE DU SÉPARATEUR DE FIN D'EN-TÊTE AVEC REPLI ROBUSTE
      	// ------------------------------------------------------------------------
      	// Test standard RFC : CRLF CRLF (\r\n\r\n)
      	l_PositionSeparateur = Position(m_MessageSocketRecu, Caract(13) + Caract(10) + Caract(13) + Caract(10))
      	SI l_PositionSeparateur > 0 ALORS
      		l_TailleSeparateur = 4
      	SINON
      		// Tolérance UNIX : LF LF (\n\n)
      		l_PositionSeparateur = Position(m_MessageSocketRecu, Caract(10) + Caract(10))
      		SI l_PositionSeparateur > 0 ALORS
      			l_TailleSeparateur = 2
      		SINON
      			// Tolérance Mac Legacy : CR CR (\r\r)
      			l_PositionSeparateur = Position(m_MessageSocketRecu, Caract(13) + Caract(13))
      			SI l_PositionSeparateur > 0 ALORS
      				l_TailleSeparateur = 2
      			FIN
      		FIN
      	FIN
      	
      	// MECANISME DE SECOURS (Clients non conformes omettant la ligne vide avant JSON/XML)
      	// Détection de la première ouverture de charge utile JSON ({ ou [) après un retour à la ligne
      	SI l_PositionSeparateur <= 0 ALORS
      		l_PositionAccoladeSecours = Position(m_MessageSocketRecu, Caract(10) + "{")
      		SI l_PositionAccoladeSecours <= 0 ALORS
      			l_PositionAccoladeSecours = Position(m_MessageSocketRecu, Caract(10) + "[")
      		FIN
      		
      		SI l_PositionAccoladeSecours > 0 ALORS
      			l_PositionSeparateur	= l_PositionAccoladeSecours
      			l_TailleSeparateur		= 1
      		FIN
      	FIN
      	
      	// Si aucun en-tête ni corps n'est dissociable, la trame est corrompue
      	SI l_PositionSeparateur <= 0 ALORS
      		m_EnteteRequete	= ""
      		m_CorpsRequete	= ""
      		SI m_Journal <> Null ALORS
      			m_Journal.EnregistrerErreur("Requête HTTP invalide : séparateur d'en-têtes introuvable.", m_NomHote, "AVERTISSEMENT", "")
      		FIN
      		RETOUR
      	FIN
      	
      	// Isolement strict des blocs En-tête et Corps
      	m_EnteteRequete = m_MessageSocketRecu[[1 À l_PositionSeparateur - 1]]
      	
      	// ------------------------------------------------------------------------
      	// 2. EXTRACTION ET NORMALISATION DES EN-TÊTES CLIENTS
      	// ------------------------------------------------------------------------
      	// Exécuté immédiatement pour récupérer le Content-Length avant d'extraire le corps
      	_ExtraireParametres()
      	
      	// ------------------------------------------------------------------------
      	// 3. EXTRACTION CALIBRÉE DU CORPS (CONTENT-LENGTH)
      	// ------------------------------------------------------------------------
      	// Si un Content-Length est fourni, on lit exactement le nombre d'octets prévus
      	// Cela évite la pollution par des octets traînants (socket Keep-Alive ou résidus TCP)
      	l_TailleContenuDeclaree = 0
      	SI m_Parametres["content-length"] <> "" ALORS
      		l_TailleContenuDeclaree = Val(SansEspace(m_Parametres["content-length"]))
      	FIN
      	
      	SI l_TailleContenuDeclaree > 0 ALORS
      		m_CorpsRequete = m_MessageSocketRecu[[l_PositionSeparateur + l_TailleSeparateur À (l_PositionSeparateur + l_TailleSeparateur + l_TailleContenuDeclaree - 1)]]
      	SINON
      		m_CorpsRequete = m_MessageSocketRecu[[l_PositionSeparateur + l_TailleSeparateur À ]]
      	FIN
      	
      	// ------------------------------------------------------------------------
      	// 4. EXTRACTION ET NORMALISATION DE LA REQUEST-LINE (LIGNE 1)
      	// ------------------------------------------------------------------------
      	// Ignore les lignes vides initiales éventuelles (tolérance RFC 7230 §3.5)
      	l_PremiereLigne = ""
      	POUR TOUTE CHAÎNE l_LigneEnTeteSecours DE m_EnteteRequete SEPAREE PAR Caract(10)
      		l_LigneEnTeteSecours	= Remplace(l_LigneEnTeteSecours, Caract(13), "")
      		l_LigneEnTeteSecours	= SansEspace(l_LigneEnTeteSecours)
      		SI l_LigneEnTeteSecours <> "" ALORS
      			l_PremiereLigne = l_LigneEnTeteSecours
      			SORTIR
      		FIN
      	FIN
      	
      	SI l_PremiereLigne = "" ALORS
      		RETOUR
      	FIN
      	
      	// Normalisation des séparateurs internes (remplacement des espaces multiples et tabulations)
      	l_PremiereLigne = Remplace(l_PremiereLigne, Caract(9), " ")
      	TANTQUE Position(l_PremiereLigne, "  ") > 0
      		l_PremiereLigne = Remplace(l_PremiereLigne, "  ", " ")
      	FIN
      	
      	m_TypeRequete				= Majuscule(SansEspace(ExtraitChaîne(l_PremiereLigne, 1, " ")))
      	m_UrlRecue					= SansEspace(ExtraitChaîne(l_PremiereLigne, 2, " "))
      	m_VersionHttp				= Majuscule(SansEspace(ExtraitChaîne(l_PremiereLigne, 3, " ")))
      	
      	// ------------------------------------------------------------------------
      	// 5. NORMALISATION DE L'URI (ABSOLUTE-FORM VS ORIGIN-FORM)
      	// ------------------------------------------------------------------------
      	l_PositionSeparateurSchema	= Position(m_UrlRecue, "://")
      	SI l_PositionSeparateurSchema > 0 ALORS
      		l_PositionPremierSlashApresHote			= Position(m_UrlRecue, "/", l_PositionSeparateurSchema + 3)
      		l_PositionPointInterrogationApresHote	= Position(m_UrlRecue, "?", l_PositionSeparateurSchema + 3)
      		
      		SI l_PositionPremierSlashApresHote > 0 ALORS
      			SI m_NomHote = "" ALORS
      				l_PartieHote = m_UrlRecue[[l_PositionSeparateurSchema + 3 À l_PositionPremierSlashApresHote - 1]]
      				SI Position(l_PartieHote, ":") > 0 ALORS
      					m_NomHote = l_PartieHote[[1 À Position(l_PartieHote, ":") - 1]]
      				SINON
      					m_NomHote = l_PartieHote
      				FIN
      			FIN
      			m_UrlRecue = m_UrlRecue[[l_PositionPremierSlashApresHote À ]]
      			
      		SINON SI l_PositionPointInterrogationApresHote > 0 ALORS
      			SI m_NomHote = "" ALORS
      				l_PartieHote = m_UrlRecue[[l_PositionSeparateurSchema + 3 À l_PositionPointInterrogationApresHote - 1]]
      				SI Position(l_PartieHote, ":") > 0 ALORS
      					m_NomHote = l_PartieHote[[1 À Position(l_PartieHote, ":") - 1]]
      				SINON
      					m_NomHote = l_PartieHote
      				FIN
      			FIN
      			m_UrlRecue = "/" + m_UrlRecue[[l_PositionPointInterrogationApresHote À ]]
      			
      		SINON
      			SI m_NomHote = "" ALORS
      				l_PartieHote = m_UrlRecue[[l_PositionSeparateurSchema + 3 À ]]
      				SI Position(l_PartieHote, ":") > 0 ALORS
      					m_NomHote = l_PartieHote[[1 À Position(l_PartieHote, ":") - 1]]
      				SINON
      					m_NomHote = l_PartieHote
      				FIN
      			FIN
      			m_UrlRecue = "/"
      		FIN
      	FIN
      	
      	// Élimination des fragments côté serveur (#)
      	l_PositionFragment = Position(m_UrlRecue, "#")
      	SI l_PositionFragment > 0 ALORS
      		m_UrlRecue = m_UrlRecue[[1 À l_PositionFragment - 1]]
      	FIN
      	
      	// Sécurisation : l'URL relative doit obligatoirement commencer par un slash
      	SI m_UrlRecue = "" ALORS
      		m_UrlRecue = "/"
      	SINON SI m_UrlRecue[[1]] <> "/" ALORS
      		m_UrlRecue = "/" + m_UrlRecue
      	FIN
      	
      	// ------------------------------------------------------------------------
      	// 6. EXTRACTION DU POINT D'ENTRÉE DU ROUTEUR RaaD
      	// ------------------------------------------------------------------------
      	l_PositionInterrogation = Position(m_UrlRecue, "?")
      	SI l_PositionInterrogation > 0 ALORS
      		l_UrlSansParametres = m_UrlRecue[[1 À l_PositionInterrogation - 1]]
      	SINON
      		l_UrlSansParametres = m_UrlRecue
      	FIN
      	
      	SI l_UrlSansParametres[[1]] = "/" ALORS
      		l_UrlSansParametres = l_UrlSansParametres[[2 À ]]
      	FIN
      	
      	SI Position(l_UrlSansParametres, "/") > 0 ALORS
      		m_PointDEntree = Minuscule(l_UrlSansParametres[[1 À Position(l_UrlSansParametres, "/") - 1]])
      	SINON
      		m_PointDEntree = Minuscule(l_UrlSansParametres)
      	FIN
      	
      	// ------------------------------------------------------------------------
      	// 7. AFFECTATION DES VARIABLES D'ENVIRONNEMENT CLIENT
      	// ------------------------------------------------------------------------
      	// Résolution de l'Hôte (priorité à l'en-tête HTTP Host si absent de la Request-Line)
      	l_ValeurHote = SansEspace(m_Parametres["host"])
      	SI l_ValeurHote <> "" ALORS
      		SI Position(l_ValeurHote, ":") > 0 ALORS
      			m_NomHote = l_ValeurHote[[1 À Position(l_ValeurHote, ":") - 1]]
      		SINON
      			m_NomHote = l_ValeurHote
      		FIN
      	FIN
      	
      	// Résolution du User-Agent
      	l_ValeurUserAgent = SansEspace(m_Parametres["user-agent"])
      	SI l_ValeurUserAgent <> "" ALORS
      		m_UserAgent = l_ValeurUserAgent
      	FIN
      	
      	// Résolution de l'IP avec support des proxys et répartiteurs de charge
      	l_AdresseIpTransferee = SansEspace(m_Parametres["x-forwarded-for"])
      	SI l_AdresseIpTransferee = "" ALORS
      		l_AdresseIpTransferee = SansEspace(m_Parametres["x-real-ip"])
      	FIN
      	
      	SI l_AdresseIpTransferee <> "" ALORS
      		SI Position(l_AdresseIpTransferee, ",") > 0 ALORS
      			m_AdresseIp = SansEspace(ExtraitChaîne(l_AdresseIpTransferee, 1, ","))
      		SINON
      			m_AdresseIp = l_AdresseIpTransferee
      		FIN
      	SINON
      		SI m_AdresseIp = "" ALORS
      			m_AdresseIp = m_AdresseClient
      		FIN
      	FIN
      	
      FAIRE
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur("Échec critique lors de l'analyse de la requête HTTP.", m_NomHote, "CRITIQUE", ExceptionInfo(errComplet))
      	FIN
      FIN
     type : 458752
   -
     name : _ExtraireParametres
     procedure_id : 1891211195791150258
     type_code : 12
     code : |1-
      procédure privée _ExtraireParametres()
      
      LOCAL
      	l_IndicePosition	est un entier
      	l_UrlParametre		est une chaîne
      	l_SousChaine		est une chaîne
      
      // Récupérer les paramètres passés dans l'URL
      SI Position(m_UrlRecue, "?") > 0 ALORS
      	l_UrlParametre = m_UrlRecue[[Position(m_UrlRecue, "?") + 1 À]]
      	POUR TOUTE CHAÎNE l_SousChaine DE l_UrlParametre SÉPARÉE PAR "&"
      		l_IndicePosition = Position(l_SousChaine, "=")
      		SI l_IndicePosition > 0 ALORS
      			m_Parametres[SansEspace(l_SousChaine[[À l_IndicePosition - 1]])] = SansEspace(l_SousChaine[[l_IndicePosition + 1 À]])
      		FIN	
      	FIN
      FIN
      
      // Récupérer les paramètres passés dans l'en-tête.
      POUR TOUTE CHAÎNE l_SousChaine DE m_EnteteRequete SÉPARÉE PAR RC
      	l_IndicePosition = Position(l_SousChaine, ":")	
      	SI l_IndicePosition > 0 ALORS
      		m_Parametres[SansEspace(l_SousChaine[[À l_IndicePosition - 1]])] = SansEspace(l_SousChaine[[l_IndicePosition + 1 À]])	
      	FIN
      FIN
     type : 458752
   -
     name : _GenererEnteteReponse
     procedure_id : 1891211195791215794
     type_code : 12
     code : |1+
      // ==============================================================================
      // Méthode : _GenererEnteteReponse (CLCanalSocket.wdc)
      // Rôle    : Génère l'entête HTTP/1.1 complet conforme avec Types MIME et Cache
      // Version : WinDev 25 (Strict)
      // ==============================================================================
      PROCÉDURE PRIVÉE _GenererEnteteReponse() : chaîne
      
      // Génération de l'en-tête de la réponse HTTP
      LOCAL
      	l_Valeur		est une chaîne = [
      HTTP/1.1 %1
      Accept-Ranges:bytes
      Content-Length:%2
      Server:RaaD 1.2
      Date:%3
      Connection:Keep-Alive
      ]
      	l_DateServeur	est une DateHeure = DateHeureLocaleVersUTC(DateHeureSys())
      
      l_Valeur = ChaîneConstruit(l_Valeur, m_CodeReponse, Taille(m_ContenuBuffer), DateVersChaîne(l_DateServeur.PartieDate, "JJ MMM AAAA") + " " + HeureVersChaîne(l_DateServeur.PartieHeure, "HH:MM:SS") + " GMT")
      l_Valeur += [RC] + m_configuration.ObtenirInfoExtension(m_extension)
      
      SI m_Gzip ALORS
      	l_Valeur += [RC] + "Content-Encoding:gzip"
      FIN
      
      RENVOYER l_Valeur
     type : 458752
   -
     name : GenererReponse
     procedure_id : 1891211195791281330
     type_code : 12
     code : |1+
      procédure GenererReponse()
      
      m_MessageSocketReponse =  _GenererEnteteReponse() + RC + RC + m_ContenuBuffer
      
     type : 458752
   -
     name : ObtenirFichier
     procedure_id : 1891211195791346866
     type_code : 12
     code : |1-
      procédure publique  ObtenirFichier() <métier>
      
      // [ARCHITECTURE RAAD : SÉCURITÉ ET OPTIMISATION I/O]
      // 1. Anti Directory-Traversal (CWE-22) : Tout chemin contenant ".." ou ":" est 
      //    immédiatement rejeté (Erreur 403). On ne nettoie pas, on bloque.
      // 2. Performances (O(1)) : Interdiction d'utiliser fRepExe() à la volée. 
      //    Le chemin racine (WWW) est lu directement depuis la configuration pré-chargée en RAM.
      
      LOCAL
      	l_CheminComplet		est une chaîne
      	
      // 1. Initialisation par défaut
      m_CodeReponse = "200 OK"
      
      // 2. Nettoyage initial des paramètres d'URL (Retrait de tout ce qui suit le '?')
      SI Position(m_UrlRecue, "?") > 1 ALORS  
      	m_UrlRecue = m_UrlRecue[[ À Position(m_UrlRecue, "?") - 1]]
      FIN
      
      // Uniformisation des séparateurs pour le système de fichiers Windows
      m_UrlRecue = Remplace(m_UrlRecue, "/", "\")
      
      // =================================================================================
      // 3. BLINDAGE ANTI-DIRECTORY TRAVERSAL & INJECTION DE CHEMIN ABSOLU
      // =================================================================================
      // On bloque toute tentative de remonter dans l'arborescence ("..") 
      // ou d'attaquer la racine d'un disque (":") ex: "C:\Windows"
      SI Position(m_UrlRecue, "..") > 0 OU Position(m_UrlRecue, ":") > 0 ALORS
      	m_CodeReponse	= "403"
      	// On présume que la configuration contient une page d'erreur 403
      	m_ContenuBuffer	= m_configuration.m_TabReponse[403] 
      	
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Tentative de Directory Traversal bloquée [IP: %1, URI: %2]", m_AdresseIp, m_UrlRecue), m_NomHote, "SECURITE")
      	FIN
      	RETOUR
      FIN
      
      // 4. Routage par défaut (Page d'accueil)
      SI m_UrlRecue = "" OU m_UrlRecue = "\" ALORS
      	m_UrlRecue = "index.html"
      FIN
      
      // Extraction très rapide de l'extension pour le type MIME et le traitement
      m_Extension		= m_UrlRecue[Position(m_UrlRecue, ".", 0, DepuisFin) À ]
      
      // =================================================================================
      // 5. OPTIMISATION MÉMOIRE : CONSTRUCTION DU CHEMIN SANS ACCÈS DISQUE (Zéro fRepExe)
      // =================================================================================
      // On récupère le répertoire cible directement depuis l'instance de configuration en RAM.
      // (Assure-toi que "RepertoireWWW" est bien chargé lors de l'initialisation du serveur).
      //l_CheminBaseWWW	= m_configuration.LireParametre("Serveur", "RepertoireWWW", "C:\RaaD\WWW")
      //l_CheminComplet	= ComplèteRep(l_CheminBaseWWW) + m_UrlRecue
      
      // 6. Lecture et Traitement du fichier cible
      QUAND EXCEPTION DANS 
      	l_CheminComplet = m_configuration.ObtenirRepertoireWWW(m_Parametres["Host"])+m_UrlRecue
      	
      //	SELON m_Extension
      //		CAS ".php" :
      //			// L'exécution PHP reste synchrone au thread courant
      //			m_ContenuBuffer = ExecuterPhp(m_configuration.LireParametreServeur("CheminPhpCgi", ""), l_CheminComplet)
      //			
      //		AUTRE CAS :
      			// Chargement brutal en mémoire. C'est l'OS qui gèrera le cache disque (File System Cache).
      			m_ContenuBuffer = fChargeBuffer(l_CheminComplet)	
      //	FIN
      	
      	// Si le buffer est vide ET que le fichier n'existe pas physiquement (évite les faux positifs sur les fichiers de 0 octet)
      	SI m_ContenuBuffer = "" ET PAS fFichierExiste(l_CheminComplet) ALORS 
      		m_CodeReponse	= "404"
      		m_ContenuBuffer	= m_configuration.m_TabReponse[404]
      	SINON 
      		// 7. Compression à la volée pour économiser la bande passante réseau
      		SI m_Extension DANS (".html", ".css", ".js", ".txt", ".xml", ".json", ".csv", ".php", ".asp", ".jsp", ".woff", ".svg", ".woff2", ".ttf", ".eot") ALORS
      			m_ContenuBuffer	= Compresse(m_ContenuBuffer, compresseGZIP)
      			m_Gzip			= Vrai
      		FIN
      	FIN
      	
      FAIRE
      	// Capture silencieuse (Thread-Safe) : Retour HTTP 500
      	// Ne jamais utiliser Erreur() ici sous peine de bloquer le serveur WLangage
      	m_CodeReponse	= "500"
      	m_ContenuBuffer	= m_configuration.m_TabReponse[500]
      	
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Exception lors de l'accès au fichier statique '%1'", l_CheminComplet), m_NomHote, "ERREUR", ExceptionInfo(errComplet))
      	FIN
      FIN
     type : 458752
