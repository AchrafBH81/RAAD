info :
 name : CLConfiguration
 major_version : 25
 minor_version : 0
 type : 4
 description : ""
 subtype : 0
class :
 identifier : 0x1a3872540054a7a6
 internal_properties : BQAAAAUAAAB2/vstTMCJbS/hlxjFxirSqKvCUuv8YxgpWyl7S3iA
 code_elements :
  type_code : 10
  p_codes :
   -
     code : |1-
      // Structure encapsulant les métadonnées d'une extension de fichier
      STInfoExtension est une Structure
      	m_TypeMime		est une chaîne			// Ex: text/css;charset=UTF-8
      	m_ControleCache	est une chaîne			// Ex: public, max-age=31536000
      FIN
      
      CLConfiguration est une Classe
      	
      	// ==============================================================================
      	// MEMBRES DE LA CLASSE (PROPRIÉTÉS)
      	// ==============================================================================
      	
      	// Chemin absolu vers le fichier de configuration (ex: Exe\Conf\config.conf)
      	m_NomFichierConfiguration	est une chaîne
      	
      	// Répertoires racines d'infrastructure
      	m_RepertoireRacineExe		est une chaîne
      	m_RepertoireProjects		est une chaîne
      	m_RepertoireSysteme			est une chaîne
      	
      	// Tableaux associatifs en RAM pour chaque section
      	m_ParametresServeur			est un tableau associatif de chaînes
      	m_ParametresBDD				est un tableau associatif de chaînes
      	m_ParametresVHost			est un tableau associatif de chaînes
      	
      	// Paramètres statiques (chargés une seule fois au démarrage)
      	m_TabReponse		est un tableau associatif de chaînes
      	
      	// Chemins Système (Centralisés)
      	m_CheminCertSSL		est une chaîne
      	m_CheminCleSSL		est une chaîne
      	
      	// Membre de classe : Stockage associatif pour un accès O(1)
      	m_TabExtensions est un tableau associatif de STInfoExtension
      FIN
     type : 131072
  procedures :
   -
     name : Constructeur
     procedure_id : 1889385748790355878
     type_code : 27
     code : |1+
      procédure Constructeur(a_NomFichierConfiguration est une chaîne = "")
      
      // 1. Détermination du répertoire racine d'exécution (Exe\)
      m_RepertoireRacineExe	= ComplèteRep(fRepExe())
      m_RepertoireProjects	= ComplèteRep(m_RepertoireRacineExe + "Projects")
      m_RepertoireSysteme		= ComplèteRep(m_RepertoireRacineExe + "Systeme")
      m_CheminCertSSL		= m_RepertoireSysteme+"SSl\cert.pem"
      m_CheminCleSSL		= m_RepertoireSysteme+"SSl\key.pem"
      
      
      
      // 2. Vérification et création préventive des dossiers racines essentiels
      SI PAS fRepExiste(m_RepertoireProjects) ALORS
      	fRepCrée(m_RepertoireProjects)
      FIN
      
      SI PAS fRepExiste(m_RepertoireSysteme) ALORS
      	fRepCrée(m_RepertoireSysteme)
      	fRepCrée(m_RepertoireSysteme + "logs")
      	fRepCrée(m_RepertoireSysteme + "www")
      FIN
      
      // 3. Chargement de la configuration si le chemin est fourni
      SI a_NomFichierConfiguration <> "" ALORS
      	m_NomFichierConfiguration = a_NomFichierConfiguration
      	ChargerConfiguration(m_NomFichierConfiguration)
      FIN
     type : 589824
   -
     name : Destructeur
     procedure_id : 1889385748790421414
     type_code : 28
     code : |1-
      procédure Destructeur()
      
      // Libération explicite de la mémoire des 3 tableaux associatifs
      SupprimeTout(m_ParametresServeur)
      SupprimeTout(m_ParametresBDD)
      SupprimeTout(m_ParametresVHost)
     type : 655360
   -
     name : ChargerConfiguration
     procedure_id : 1911106837216296334
     type_code : 12
     code : |1-
      
      
      // ==============================================================================
      // CHARGEMENT ET PARSING DU FICHIER CONFIG.CONF
      // ==============================================================================
      
      /// <summary>
      /// Charge le fichier de configuration et ventile les données dans les 3 tableaux en mémoire.
      /// </summary>
      PROCEDURE ChargerConfiguration(a_NomFichierConfiguration est une chaîne = "") : booléen
      
      LOCAL
      	l_CheminFichier	est une chaîne
      	l_ContenuTexte	est une chaîne
      	
      SI a_NomFichierConfiguration <> "" ALORS
      	m_NomFichierConfiguration = a_NomFichierConfiguration
      FIN
      
      l_CheminFichier = m_NomFichierConfiguration
      
      // Sécurité : Vérification de l'existence physique du fichier
      SI l_CheminFichier = "" OU PAS fFichierExiste(l_CheminFichier) ALORS
      	renvoyer  Faux
      FIN
      
      // Lecture intégrale du fichier disque
      l_ContenuTexte = fChargeTexte(l_CheminFichier)
      SI l_ContenuTexte = "" ALORS
      	renvoyer  Faux
      FIN
      
      // Réinitialisation des tableaux avant parsing
      SupprimeTout(m_ParametresServeur)
      SupprimeTout(m_ParametresBDD)
      SupprimeTout(m_ParametresVHost)
      
      // Parsing ligne par ligne
      _ParserFichierConf(l_ContenuTexte)
      _InitTableauxStatiques()
      renvoyer Vrai
     type : 458752
   -
     name : _ParserFichierConf
     procedure_id : 1911107180813694244
     type_code : 12
     code : |1+
      /// Méthode privée : Analyse le contenu texte et ventile dans [Serveur], [BDD] et [VHost].
      /// </summary>
      PROCEDURE PRIVÉE _ParserFichierConf(a_ContenuTexte est une chaîne)
      
      LOCAL
      	l_LigneCourante		est une chaîne
      	l_SectionCourante	est une chaîne	= ""
      	l_Cle				est une chaîne
      	l_Valeur			est une chaîne
      	l_PositionEgal		est un entier
      	l_NombreLignes		est un entier
      	l_IndiceLigne		est un entier
      	
      l_NombreLignes = ChaîneOccurrence(a_ContenuTexte, RC) + 1
      
      POUR l_IndiceLigne = 1 À l_NombreLignes
      	
      	l_LigneCourante = SansEspace(ExtraitChaîne(a_ContenuTexte, l_IndiceLigne, RC))
      	
      	// Ignorer lignes vides et commentaires (# ou ;)
      	SI l_LigneCourante = "" OU Position(l_LigneCourante, "#") = 1 OU Position(l_LigneCourante, ";") = 1 ALORS
      		CONTINUER
      	FIN
      	
      	// Détection des sections [NomDeSection]
      	SI Position(l_LigneCourante, "[") = 1 ET Position(l_LigneCourante, "]") = Taille(l_LigneCourante) ALORS
      		l_SectionCourante = Minuscule(SansEspace(Milieu(l_LigneCourante, 2, Taille(l_LigneCourante) - 2)))
      		CONTINUER
      	FIN
      	
      	// Extraction du couple Clé=Valeur
      	l_PositionEgal = Position(l_LigneCourante, "=")
      	SI l_PositionEgal > 1 ALORS
      		l_Cle		= SansEspace(Gauche(l_LigneCourante, l_PositionEgal - 1))
      		l_Valeur	= SansEspace(Milieu(l_LigneCourante, l_PositionEgal + 1))
      		
      		// Suppression des guillemets éventuels autour de la valeur
      		SI (Position(l_Valeur, """") = 1 ET Position(l_Valeur, """", Taille(l_Valeur)) = Taille(l_Valeur)) OU ...
      			(Position(l_Valeur, "'") = 1 ET Position(l_Valeur, "'", Taille(l_Valeur)) = Taille(l_Valeur)) ALORS
      			l_Valeur = Milieu(l_Valeur, 2, Taille(l_Valeur) - 2)
      		FIN
      		
      		SELON l_SectionCourante
      			CAS "serveur":
      				m_ParametresServeur[l_Cle] = l_Valeur
      				
      			CAS "bdd", "basededonnees", "base_de_donnees":
      				m_ParametresBDD[l_Cle] = l_Valeur
      				
      			CAS "host", "hosts", "virtualhosts":
      				// Stockage de l'hôte en minuscules -> Nom du sous-dossier uniquement
      				m_ParametresVHost[Minuscule(l_Cle)] = l_Valeur
      				
      			AUTRE CAS:
      				// Section non gérée ignorée
      		FIN
      	FIN
      FIN
     type : 458752
   -
     name : LireParametreBDD
     procedure_id : 1911110608197674056
     type_code : 12
     code : |1-
      procédure LireParametreBDD(a_Cle est une chaîne, a_ValeurParDefaut est une chaîne = "") : chaîne
      
      SI m_ParametresBDD[a_Cle]..Existe ALORS
      	renvoyer m_ParametresBDD[a_Cle]
      sinon
      	renvoyer a_ValeurParDefaut
      FIN
     type : 458752
   -
     name : LireParametreVHost
     procedure_id : 1911110827241056652
     type_code : 12
     code : |1+
      PROCEDURE LireParametreVHost(a_NomHote est une chaîne) : chaîne
      
      LOCAL
      	l_HoteNormalise			est une chaîne
      	l_PositionDeuxPoints	est un entier
      	
      l_HoteNormalise			= Minuscule(SansEspace(a_NomHote))
      
      // Suppression du port HTTP éventuel (ex: "localhost:8080" -> "localhost")
      l_PositionDeuxPoints	= Position(l_HoteNormalise, ":")
      SI l_PositionDeuxPoints > 0 ALORS
      	l_HoteNormalise = Gauche(l_HoteNormalise, l_PositionDeuxPoints - 1)
      FIN
      
      SI m_ParametresVHost[l_HoteNormalise]..Existe ALORS
      	renvoyer  m_ParametresVHost[l_HoteNormalise]
      sinon
      	renvoyer faux
      FIN
      
      
     type : 458752
   -
     name : ObtenirRepertoireWWW
     procedure_id : 1911112996199718796
     type_code : 12
     code : |1+
      PROCEDURE ObtenirRepertoireWWW(a_NomHote est une chaîne) : chaîne
      
      LOCAL
      l_CheminWWW est une chaîne
      	
      l_CheminWWW	= ComplèteRep(ObtenirRepertoireProjet(a_NomHote)) + "www"+["\"]
      
      
      renvoyer l_CheminWWW
      
     type : 458752
   -
     name : ObtenirRepertoireLogs
     procedure_id : 1911113077804115826
     type_code : 12
     code : |1+
      PROCEDURE ObtenirRepertoireLogs(a_NomHote est une chaîne) : chaîne
      
      LOCAL
      l_CheminLogs est une chaîne
      	
      l_CheminLogs	= ComplèteRep(ObtenirRepertoireProjet(a_NomHote)) + "logs"+["\"]
      
      renvoyer  l_CheminLogs
     type : 458752
   -
     name : LireParametreServeur
     procedure_id : 1911231215175130806
     type_code : 12
     code : |1+
      procédure lireParametreServeur(a_Cle est une chaîne, a_ValeurParDefaut est une chaîne = "") : chaîne
      
      SI m_ParametresBDD[a_Cle]..Existe ALORS
      	RENVOYER m_ParametresServeur[a_Cle]
      SINON
      	RENVOYER a_ValeurParDefaut
      FIN
      
     type : 458752
   -
     name : ObtenirRepertoireProjet
     procedure_id : 1911232293211976759
     type_code : 12
     code : |1+
      /// Résout le chemin physique absolu du projet pour un hôte donné.
      /// Si le projet est "Systeme", pointe sur Exe\Systeme\.
      /// Sinon, pointe sur Exe\Projects\[NomDossier]\.
      PROCEDURE ObtenirRepertoireProjet(a_NomHote est une chaîne) : chaîne
      
      LOCAL
      	l_NomDossier	est une chaîne
      	l_CheminProjet	est une chaîne
      	
      l_NomDossier = LireParametreVHost(a_NomHote)
      
      SI Minuscule(l_NomDossier) = "systeme" ALORS
      	l_CheminProjet = m_RepertoireSysteme
      SINON
      	l_CheminProjet = ComplèteRep(m_RepertoireProjects + l_NomDossier)
      FIN
      
      
      
      renvoyer l_CheminProjet
      
     type : 458752
   -
     name : _InitTableauxStatiques
     procedure_id : 1911248171706554714
     type_code : 12
     code : |1+
      procédure privée _InitTableauxStatiques()
      // --- CODES DE RÉPONSE HTTP ---
      m_TabReponse["200"]		= ""
      m_TabReponse["401"]		= "<html><body>Erreur 401 : Accès non autorisé.</body></html>"
      m_TabReponse["404"]		= "<html><body>Erreur 404 : Ressource introuvable sur le serveur RaaD.</body></html>"
      m_TabReponse["500"]		= "<html><body>Erreur 500 : Erreur interne du serveur RaaD.</body></html>"
      
      // --- MAPPING DES EXTENSIONS (MIME TYPES) ---
      // Tu peux également charger ça depuis un "extensions.conf" si tu veux que ce soit dynamique
      LOCAL
      	sModeleHeader est une chaîne = [
            Content-Type: %1
            Cache-Control: %2
      ]
      // HTML
      m_TabExtensions[".html"]		= ChaîneConstruit(sModeleHeader, "text/html; charset=UTF-8", "no-cache")
      // JSON
      m_TabExtensions[".json"]		= ChaîneConstruit(sModeleHeader, "application/json; charset=UTF-8", "no-cache")
      // CSS
      m_TabExtensions[".css"]			= ChaîneConstruit(sModeleHeader, "text/css", "max-age=31536000")
      // JS
      m_TabExtensions[".js"]			= ChaîneConstruit(sModeleHeader, "application/javascript", "max-age=31536000")
      
     type : 458752
   -
     name : ChargerMimeTypes
     procedure_id : 1911782508589969382
     type_code : 12
     code : |1+
      // Résumé : Charge le fichier de configuration des extensions et types MIME en RAM
      // Syntaxe : ChargerMimeTypes (<a_CheminFichierConf> est chaîne)
      PROCÉDURE ChargerMimeTypes(a_CheminFichierConf est une chaîne = "")
      
      LOCAL
      	l_CheminComplet		est une chaîne
      	l_ContenuFichier	est une chaîne
      	l_LigneCourante		est une chaîne
      	l_IndiceLigne		est un entier
      	l_NombreLignes		est un entier
      	l_Extension			est une chaîne
      	l_TypeMime			est une chaîne
      	l_ControleCache		est une chaîne
      	l_InfoExt			est un STInfoExtension
      	
      // 1. Résolution du chemin absolu du fichier de configuration
      SI a_CheminFichierConf = "" ALORS
      	l_CheminComplet = m_RepertoireProjects + "mimetypes.conf"
      SINON
      	l_CheminComplet = a_CheminFichierConf
      FIN
      
      // 2. Vérification de la présence physique du fichier
      SI PAS fFichierExiste(l_CheminComplet) ALORS
      	// Alimentation d'un jeu de secours minimal en dur si le fichier est manquant
      	_InitialiserMimeTypesSecours()
      	RETOUR
      FIN
      
      // 3. Lecture intégrale du fichier en mémoire tampon
      l_ContenuFichier = fChargeTexte(l_CheminComplet)
      SI l_ContenuFichier = "" ALORS
      	_InitialiserMimeTypesSecours()
      	RETOUR
      FIN
      
      // 4. Réinitialisation propre du tableau associatif
      SupprimeTout(m_TabExtensions)
      
      // 5. Parcours et analyse ligne par ligne
      l_NombreLignes = ChaîneOccurrence(l_ContenuFichier, RC) + 1
      
      POUR l_IndiceLigne = 1 À l_NombreLignes
      	l_LigneCourante = SansEspace(ExtraitChaîne(l_ContenuFichier, l_IndiceLigne, RC))
      	
      	// Ignorer les lignes vides et les commentaires (#)
      	SI l_LigneCourante = "" OU Position(l_LigneCourante, "#") = 1 ALORS
      		CONTINUER
      	FIN
      	
      	// Extraction des 3 colonnes : .ext;type_mime;cache_control
      	l_Extension		= Minuscule(SansEspace(ExtraitChaîne(l_LigneCourante, 1, ";")))
      	l_TypeMime		= SansEspace(ExtraitChaîne(l_LigneCourante, 2, ";"))
      	l_ControleCache	= SansEspace(ExtraitChaîne(l_LigneCourante, 3, ";"))
      	
      	// Validation : l'extension et le type MIME doivent être renseignés
      	SI l_Extension <> "" ET l_TypeMime <> "" ALORS
      		// Sécurité : forcer la présence du point initial
      		SI Position(l_Extension, ".") <> 1 ALORS
      			l_Extension = "." + l_Extension
      		FIN
      		
      		// Remplissage de la structure
      		l_InfoExt.m_TypeMime			= l_TypeMime
      		l_InfoExt.m_ControleCache		= (l_ControleCache <> "" ? l_ControleCache SINON "no-cache")
      		
      		// Affectation dans le dictionnaire associatif
      		m_TabExtensions[l_Extension]	= l_InfoExt
      	FIN
      FIN
      
     type : 458752
   -
     name : _InitialiserMimeTypesSecours
     procedure_id : 1911782680388832419
     type_code : 12
     code : |1+
      // Résumé : Initialise les types MIME vitaux en dur en cas d'absence du fichier externe
      PROCÉDURE PRIVÉE _InitialiserMimeTypesSecours()
      
      LOCAL
      	l_InfoExt est un STInfoExtension
      	
      SupprimeTout(m_TabExtensions)
      
      // HTML
      l_InfoExt.m_TypeMime		= "text/html;charset=UTF-8"
      l_InfoExt.m_ControleCache	= "no-cache"
      m_TabExtensions[".html"]	= l_InfoExt
      m_TabExtensions[".htm"]		= l_InfoExt
      
      // CSS / JS
      l_InfoExt.m_TypeMime		= "text/css;charset=UTF-8"
      l_InfoExt.m_ControleCache	= "public, max-age=31536000"
      m_TabExtensions[".css"]		= l_InfoExt
      
      l_InfoExt.m_TypeMime		= "text/javascript;charset=UTF-8"
      m_TabExtensions[".js"]		= l_InfoExt
      
      // JSON
      l_InfoExt.m_TypeMime		= "application/json;charset=UTF-8"
      l_InfoExt.m_ControleCache	= "no-cache"
      m_TabExtensions[".json"]	= l_InfoExt
      
      // Octet-stream par défaut
      l_InfoExt.m_TypeMime		= "application/octet-stream"
      l_InfoExt.m_ControleCache	= "no-cache"
      m_TabExtensions[".*"]		= l_InfoExt
      
     type : 458752
   -
     name : ObtenirInfoExtension
     procedure_id : 1911782804942977914
     type_code : 12
     code : |1+
      // Résumé : Recherche les métadonnées MIME et Cache associées à une extension
      // Syntaxe :
      //[ <Résultat> = ] ObtenirInfoExtension (<a_NomFichierOuExtension> est chaîne)
      PROCÉDURE ObtenirInfoExtension(a_NomFichierOuExtension est une chaîne) : STInfoExtension
      
      LOCAL
      	l_ExtensionNettoyee	est une chaîne
      	l_InfoResultat		est un STInfoExtension
      	
      // Extraction propre de l'extension
      l_ExtensionNettoyee = Minuscule(SansEspace(fExtraitChemin(a_NomFichierOuExtension, fExtension)))
      
      // Si aucune extension n'a été trouvée ou si la chaîne passée était déjà l'extension pure
      SI l_ExtensionNettoyee = "" ALORS
      	l_ExtensionNettoyee = Minuscule(SansEspace(a_NomFichierOuExtension))
      	SI Position(l_ExtensionNettoyee, ".") <> 1 ALORS
      		l_ExtensionNettoyee = "." + l_ExtensionNettoyee
      	FIN
      FIN
      
      // Recherche O(1) dans le tableau associatif
      SI m_TabExtensions[l_ExtensionNettoyee]..Existe ALORS
      	l_InfoResultat = m_TabExtensions[l_ExtensionNettoyee]
      SINON
      	// Valeurs de repli universelles
      	l_InfoResultat.m_TypeMime		= "application/octet-stream"
      	l_InfoResultat.m_ControleCache	= "no-cache"
      FIN
      
      RENVOYER l_InfoResultat
      
     type : 458752
