      procédure Destructeur()
      
      SocketFerme(m_NomSocketEcoute)
     type : 655360
   -
     name : AttenteConnexion
     procedure_id : 1478780694846627284
     type_code : 12
     code : |1-
      procédure AttenteConnexion() <métier>
      
      SI SocketAttendConnexion(m_NomSocketEcoute) ALORS
      	
      	// Nouvelle demande de connexion
      	// Dans cet exemple, on accepte les connexions
      	m_NomCanal = SocketAccepte(m_NomSocketEcoute)
      	
      	// Vérification de l'opération d'acceptation
      	// On lance un thread pour gérer cette connexion
      	// sNomThread = sNomCanal
      	SI m_NomCanal <> "" ALORS 
      		GestionConnexion(m_NomCanal)
      	SINON
      		SI ErreurDétectée ET m_Journal <> Null ALORS
      			m_Journal.EnregistrerErreur(ChaîneConstruit("Échec de SocketAccepte sur l'écouteur '%1' : %2", m_NomSocketEcoute, ErreurInfo(errComplet)), "", "AVERTISSEMENT")
      		FIN
      	FIN
      		
      FIN
     type : 458752
   -
     name : GestionConnexion
     internal_properties : BQAAAAUAAABqmWvBafCASa0jyDBaFgsD7FKfsAM/xKex7Lx4BSM4QBBfG6XXTIgHF+4bsU5osJPV4st+f9p/jyOdqfSwWRdJB4t5gEEo5ZMaGflQHvqMEQvC085KLnobXVJHReEi3zTDo8yAvyv7OC8yQa8wuPKgu/mvrQQKFggLiFKaoiblZg==
     procedure_id : 1478780694846692820
     type_code : 12
     code : |1+
      // --------------------------------------------------------------------------------------
      // Procédure automatique :
      // La procédure est exécutée manuellement, lors d'un appel dans le code
      // Elle s'exécutera dans un thread (sans avoir besoin d'appeler la fonction ThreadExecute), sans utilisation de HFSQL
      // 
      
      procédure privée GestionConnexion(LOCAL a_NomConnexion est une chaîne)
      
      LOCAL
      	l_CanalSocket est un CLCanalSocket dynamique = new CLCanalSocket(m_configuration)
      
      QUAND EXCEPTION DANS
      	
      	l_CanalSocket.m_MessageSocketRecu = SocketLit(a_NomConnexion, Faux)
      	SI l_CanalSocket.m_MessageSocketRecu <> "" ALORS 
      		l_CanalSocket.m_NomSocket		= a_NomConnexion
      		l_CanalSocket.m_AdresseClient	= SocketClientInfo(a_NomConnexion, SocketAdresse)
      		
      		m_ProcedureRappel(l_CanalSocket)
      		
      		SocketEcrit(a_NomConnexion, l_CanalSocket.m_MessageSocketReponse)
      	FIN
      	
      	// Fermeture de la socket
      	SocketFerme(a_NomConnexion)
      	
      FAIRE
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Exception réseau sur la socket cliente '%1'", a_NomConnexion), "", "ERREUR", ExceptionInfo(errComplet))
      	FIN
      	
      	SocketFerme(a_NomConnexion)
      	
      FIN
     type : 458752
   -
     name : Demarre
     procedure_id : 1478780694846758356
     type_code : 12
     code : |1+
      procédure Demarre()
      
      LOCAL
      	l_ErreurSurvenue est une chaîne
      
      SocketCrée(m_NomSocketEcoute, m_PortSocket)
      
      SI ErreurDétectée ALORS
      	l_ErreurSurvenue = ErreurInfo(errComplet)
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Impossible de mettre en place la socket d'écoute '%1' sur le port %2 : %3", m_NomSocketEcoute, m_PortSocket, l_ErreurSurvenue), "", "CRITIQUE")
      	FIN
      	RETOUR
      FIN
      
      SocketChangeModeTransmission(m_NomSocketEcoute, SocketSansMarqueurFin)
      
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Socket d'écoute '%1' active sur le port %2 (Mode: SocketSansMarqueurFin).", m_NomSocketEcoute, m_PortSocket), "", "INFO")
      FIN
      
      // =========================================================================
      // DÉMARRAGE DU REVERSE-PROXY HTTPS (Appel vers l'assemblage C#)
      // =========================================================================
      // On encapsule l'appel dans un ThreadExécute pour que la boucle infinie 
      // du code C# ne bloque pas le démarrage du serveur WLangage.
      // ThreadExécute("Thread_Proxy_HTTPS", threadNormal, _LancerServeurHttpsEntrantAsync)
     type : 458752
   -
     name : Arret
     procedure_id : 1537883821397867347
     type_code : 12
     code : |1-
      procédure Arret()
      
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Arrêt de l'écoute socket sur '%1'.", m_NomSocketEcoute), "", "INFO")
      FIN
      
      SocketFerme(m_NomSocketEcoute)
     type : 458752
