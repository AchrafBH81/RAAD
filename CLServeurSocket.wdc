 code_elements :
  type_code : 10
  p_codes :
   -
     code : |1+
      CLServeurSocket est une Classe
      	m_ProcedureRappel			est une procédure
      Prive
      	m_configuration				est CLConfiguration dynamique
      	m_Journal					est CLJournalisation dynamique
      	m_PortSocket				est un entier	= 5010
      	m_NomSocketEcoute			est une chaîne
      	m_NomCanal					est une chaîne
      	m_CheminPhpCgi				est une chaîne
      fin
     type : 131072
  procedures :
