      CLApplication est une Classe
      	
      prive
      	// Infrastructure réseau Socket TCP
      	m_ServeurSocket					est CLServeurSocket dynamique 
      	m_CanalSocket					est CLCanalSocket dynamique 			
      	
      	// Services d'infrastructure RaaD
      	m_Configuration					est CLConfiguration dynamique
      	m_Journal						est CLjournalisation dynamique
      	m_MonitoringServeur				est un CLMonitoring
      	m_GestionnaireSSL				est CLGestionnaireSSL dynamique
      	m_Securite						est CLSecurite dynamique
      	m_PontHttp3						est un CLGestionnaireHttp3 dynamique
      	
      	// Couche d'accès aux données HFSQL
      	m_Base							est CLBase dynamique  
      	m_CodeReponse					est un tableau associatif de buffers 
      	
      	// Moteur autonome de cache mémoire (RAM)
      	m_Cache							est ClCache dynamique
      	
      	// Gestionnaire d'exécution polyglotte (PHP, Python, WLangage, Node.js, PowerShell, Lua)
      	m_GestionnaireExterne			est CLGestionnaireExterne dynamique
      fin
      
