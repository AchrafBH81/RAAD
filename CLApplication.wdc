   -
     name : MessageRecu
     procedure_id : 1465891540924885333
     type_code : 12
     code : |1-
      
      // ==============================================================================
      // Méthode : MessageRecu (CLApplication.wdc)
      // Rôle    : Point d'entrée de chaque socket threadé avec télémétrie intégrée
      // ==============================================================================
      PROCÉDURE MessageRecu(a_SocketRecu est CLCanalSocket)
      
      l_DateHeureDebut est une DateHeure = DateHeureSys()
      m_MonitoringServeur:IncrementerSocketsActifs()
      
      a_SocketRecu:AnalyserRequete()
      
      LOCAL
      	l_UriDemande est une chaîne = a_SocketRecu:m_UrlRecue
      	
      	// ==============================================================================
      	// ROUTAGE DES REQUÊTES (Compatible WinDev 25)
      	// ==============================================================================
      	
      // Route 0 : Validation automatique du Challenge ACME Let's Encrypt (Priorité Absolue)
      SI Position(l_UriDemande, ".well-known/acme-challenge/", 1, SansCasse) = 1 ALORS
      	_TraiterRequeteAcmeChallenge(a_SocketRecu)
      	
      	// Route 1 : API Métriques de Supervision RaaD Ops
      SINON SI Position(l_UriDemande, "api/v1/monitoring/systeme", 1, SansCasse) = 1 ALORS
      	_TraiterRequeteMonitoring(a_SocketRecu)
      	
      	// Route 2 : ORM et Données REST
      SINON SI Position(l_UriDemande, "api/v1/data/", 1, SansCasse) = 1 ALORS
      	_TraiterRequeteApi(a_SocketRecu)
      	
      	// Route 3 : Requêtes SQL directes
      SINON SI Position(l_UriDemande, "api/v1/sql", 1, SansCasse) = 1 ALORS
      	_ExecuterRequeteSQL(a_SocketRecu)
      	
      	// Route 4 : Diagnostic Mémoire Système
      SINON SI Position(l_UriDemande, "api/v1/memoire", 1, SansCasse) = 1 ALORS
      	_GetMemory(a_SocketRecu)
      	
      	// Route 5 : Fichiers statiques WWW
      SINON
      	_ObtenirFichier(a_SocketRecu)
      FIN
      
      a_SocketRecu:GenererReponse()
      
      l_DureeEcoulee	est une Durée	= DateHeureSys() - l_DateHeureDebut
      l_LatenceMs		est un réel		= l_DureeEcoulee..EnMillisecondes
      l_CodeStatut	est un entier	= Val(a_SocketRecu:m_CodeReponse)
      SI l_CodeStatut = 0 ALORS
      	l_CodeStatut = 200
      FIN
      
      m_MonitoringServeur:EnregistrerRequete(l_CodeStatut, l_LatenceMs)
      m_MonitoringServeur:DecrementerSocketsActifs()
     type : 458752
