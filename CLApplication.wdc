   -
     name : MessageRecu
     procedure_id : 1465891540924885333
     type_code : 12
     code : |1+
      
      procédure MessageRecu(a_SocketRecu est CLCanalSocket) 
      
      // 1. Décodage et parsing initial de la requête HTTP
      a_SocketRecu.AnalyserRequete()
      
      LOCAL
      	l_UriDemande est une chaîne = a_SocketRecu.m_UrlRecue
      	
      	// =================================================================================
      	// AIGUILLAGE PRINCIPAL : API VS FICHIERS STATIQUES (Rétrocompatibilité WinDev 25)
      	// =================================================================================
      	
      // Vérification O(1) via Position() au lieu du CommencePar() inexistant en V25
      SI Position(l_UriDemande, "api/v1/data/", 1, SansCasse) = 1 ALORS
      	// Délégation complète du traitement de l'API à notre nouvelle méthode dédiée
      	_TraiterRequeteApi(a_SocketRecu)
      	
      SINON SI Position(l_UriDemande, "api/v1/sql", 1, SansCasse) = 1 ALORS
      	_ExecuterRequeteSQL(a_SocketRecu)
      	
      SINON SI Position(l_UriDemande, "api/v1/memoire", 1, SansCasse) = 1 ALORS
      	_GetMemory(a_SocketRecu)
      	
      SINON
      	// Par défaut, traitement des ressources statiques (HTML, CSS, images)
      	_ObtenirFichier(a_SocketRecu)
      FIN
      
      // Envoi final de la réponse construite au client TCP
      a_SocketRecu.GenererReponse()
      
     type : 458752
   -
     name : Execute
     procedure_id : 1466997623856337504
     type_code : 12
     code : |1+
      
      procédure Execute()
      
      
      
      
