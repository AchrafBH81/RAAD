     code : |1+
      CLEnregistrement est une Classe
      	m_condition					est une chaîne 
      	m_erreur					est une chaîne 
      	m_json						est une chaîne	// Représentation JSON de l'entité active 
      	m_RequeteSQL				est une chaîne	// Dernier code SQL exécuté par l'instance
      	m_NomTable					est une chaîne	// Nom physique de la table / fichier HFSQL manipulé
      	m_CleUnique					est une chaîne	// Nom de la colonne constituant la clé primaire unique identifiée
      	m_ValeurCle					est une chaîne	// Valeur active de la clé primaire de l'enregistrement chargé
      	
      	// Paramètres d'accès HFSQL Client/Serveur
      	m_ProviderBdd				est une chaîne	
      	m_ServeurBdd				est une chaîne
      	m_NomBaseDonnees			est une chaîne
      	m_UtilisateurBdd			est une chaîne
      	m_MotDePasseBdd				est une chaîne
      	
      	// Nom logique unique de la session HFSQL pour l'action courante
      	m_NomConnexion				est une chaîne	= ""
      	
      	// Moteur de journalisation asynchrone
      	m_Journal					est CLJournalisation dynamique
      	
      	// Référence partagée directe vers le moteur de cache autonome
      	m_Cache						est ClCache dynamique
      fin
     type : 131072
