     name : AssocierCache
     procedure_id : 1891210886552449999
     type_code : 12
     code : |1+
      // ==============================================================================
      // Méthode : AssocierCache
      // Rôle    : Lie l'instance partagée de ClCache par prise de référence (Opérateur <-)
      // Version : WinDev 25 Strict (Réf PC SOFT 1515003)
      // ==============================================================================
      PROCÉDURE AssocierCache(a_Cache est ClCache)
      
      m_Cache <- a_Cache
     type : 458752
   -
     name : Init
     internal_properties : BQAAAAUAAAA8hxYh8NT7LRSzqVlUm63FeSLWqDaACT4vutQ1tRyK6waTMYTBkjB9IBg6+M6WNQ5s3Lz1tg6105gULa4k5Aw9twj6ImxKb2oGXupoStv0Z3RJJ8+7nCE+yueCfLFSrJEhgBedYhfD/A7J5GOino9yC3kNhJ6LTvX+u3r001Y2x/6aWgbnZoxpyMVNR3tvwj8zw2tMx8w=
     procedure_id : 1891210886552515520
     type_code : 12
     code : |1+
      procédure Init(a_Table est une chaîne)
      
      // on initialise la classe avec le nom de la table 
      m_NomTable = a_Table
      LOCAL
      	l_IndRub	est un entier	= 0
      	l_ResRub	est une chaîne
      	l_NomRub	est une chaîne
      
      // Extraction de la structure de la table 
      Connexion()
      HChangeConnexion({m_NomTable, indFichier}, {m_NomConnexion})
      
      l_ResRub = HListeClé(m_NomTable, hLstDétailPlus)
      
      POUR TOUTE CHAÎNE l_Rub DE l_ResRub SÉPARÉE PAR RC
      	l_IndRub = 0
      	POUR TOUTE CHAÎNE l_DesRub DE l_Rub SÉPARÉE PAR TAB
      		SELON l_IndRub
      			CAS 0 : l_NomRub = l_DesRub
      			CAS 4 : SI Val(l_DesRub) = 1 ALORS m_CleUnique = l_NomRub
      		FIN
      		
      		l_IndRub++ 
      		SI l_IndRub = 5 OU m_CleUnique <> "" ALORS SORTIR 
      	FIN
      
      	SI m_CleUnique <> "" ALORS SORTIR
      FIN
      
      CAS ERREUR:
      Déconnexion()
      m_erreur = ErreurInfo()
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Erreur HFSQL lors de l'introspection Init() sur la table '%1' : %2", m_NomTable, m_erreur), "", "ERREUR")
      FIN
      
      CAS EXCEPTION:
      Déconnexion()
      m_erreur = ExceptionInfo()
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Exception lors de l'introspection Init() sur la table '%1'", m_NomTable), "", "CRITIQUE", ExceptionInfo(errComplet))
      FIN
     type : 458752
   -
     name : Charger
     procedure_id : 1891210886552581056
     type_code : 12
     code : |1-
      procédure Charger(LOCAL a_ValKey est une chaîne, a_Condition est une chaîne = "", a_IgnorerCache est un booléen = Faux)
      
      m_ValeurCle	= a_ValKey
      m_condition	= a_Condition
      
      LOCAL
      	l_ReqSql			est une Source de Données
      	l_ResEnregistrement	est un Enregistrement 
      	l_CacheJsonTrouve	est une chaîne = ""
      
      SI m_ValeurCle <> "" ALORS
      	m_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2", m_NomTable, m_CleUnique + " = " + m_ValeurCle)
      SINON
      	m_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2", m_NomTable, m_condition) 
      FIN
      
      // Contrôle du micro-cache SQL autonome
      SI PAS a_IgnorerCache ET m_Cache <> Null ALORS
      	l_CacheJsonTrouve = m_Cache.ObtenirParSql(m_RequeteSQL)
      	SI l_CacheJsonTrouve <> "" ALORS
      		m_json   = l_CacheJsonTrouve
      		m_erreur = ""
      		RETOUR
      	FIN
      FIN
      
      Connexion()
      HExécuteRequêteSQL(l_ReqSql, m_NomConnexion, hRequêteSansCorrection, m_RequeteSQL)
      
      // lire le premier enregistrement  
      HLitPremier(l_ReqSql)
      FichierVersMémoire(l_ResEnregistrement, l_ReqSql)
      HAnnuleDéclaration(l_ReqSql)
      
      // Sérialisation de l’enregistrement 
      Sérialise(l_ResEnregistrement, m_json, psdJSON)
      
      // Mémorisation dans le micro-cache
      SI m_Cache <> Null ET m_json <> "" ALORS
      	m_Cache.MettreParSql(m_RequeteSQL, m_NomBaseDonnees, m_json)
      FIN
      
      CAS ERREUR:
      Déconnexion()
      m_erreur = ErreurInfo()
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Erreur HFSQL Charger() sur la table '%1' (Clé: %2) : %3", m_NomTable, m_ValeurCle, m_erreur), "", "ERREUR")
      FIN
      
      CAS EXCEPTION:
      Déconnexion()
      m_erreur = ExceptionInfo()
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Exception Charger() sur la table '%1' (Clé: %2)", m_NomTable, m_ValeurCle), "", "CRITIQUE", ExceptionInfo(errComplet))
      FIN
      
      FIN :
      Déconnexion()
     type : 458752
   -
     name : Modifier
     procedure_id : 1891210886552646592
     type_code : 12
     code : |1-
      // ==============================================================================
      // Méthode   : Modifier
      // Rôle      : Mise à jour sécurisée avec requêtes paramétrées anti-injection
      // Sécurité  : Verrou absolu anti-UPDATE global (clause WHERE obligatoire)
      // Version   : WinDev 25 (Strict)
      // ==============================================================================
      
      LOCAL
      	l_SourceRequete			est une Source de Données
      	l_DonneesJson			est un Variant
      	l_ClauseWhere			est une chaîne	= ""
      	l_CorpsReq				est une chaîne	= ""
      	l_NomParametre			est une chaîne
      	l_SuccesExecution		est un booléen	= Faux
      	l_CleTrouveeDansJson	est un booléen	= Faux
      	
      // 1. Validation de surface : table et clé primaire obligatoires
      SI SansEspace(m_NomTable) = "" OU SansEspace(m_CleUnique) = "" ALORS
      	m_erreur = "Erreur ORM : Table ou clé unique non configurée."
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(m_erreur, "", "AVERTISSEMENT")
      	FIN
      	RENVOYER Faux
      FIN
      
      // 2. Désérialisation du buffer JSON
      l_DonneesJson = JSONVersVariant(m_json)
      SI l_DonneesJson = Null ALORS
      	m_erreur = "Erreur ORM : Contenu JSON invalide ou vide."
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Échec de parsing JSON pour modification sur la table '%1'", m_NomTable), "", "AVERTISSEMENT")
      	FIN
      	RENVOYER Faux
      FIN
      
      // 3. Parcours du JSON et alimentation des paramètres de liaison
      POUR TOUT l_Ligne DE l_DonneesJson
      	l_NomParametre = "p_" + l_Ligne..Nom
      	
      	// Comparaison insensible à la casse pour détecter la clé primaire dans le corps
      	SI Minuscule(SansEspace(l_Ligne..Nom)) = Minuscule(SansEspace(m_CleUnique)) ALORS
      		l_CleTrouveeDansJson	= Vrai
      		l_ClauseWhere			= "WHERE " + m_CleUnique + " = {" + l_NomParametre + "}"
      	SINON
      		// Construction de la liste SET
      		l_CorpsReq += [", " + RC] + l_Ligne..Nom + " = {" + l_NomParametre + "}"
      	FIN
      	
      	// Affectation dynamique sécurisée
      	{"l_SourceRequete." + l_NomParametre} = l_Ligne..Valeur
      FIN
      
      // 4. Repli : Si la clé n'était pas dans le JSON, utilisation de m_ValeurCle (reçue de l'URL)
      SI PAS l_CleTrouveeDansJson ET SansEspace(m_ValeurCle) <> "" ALORS
      	{"l_SourceRequete.p_CleUniqueUrl"} = m_ValeurCle
      	l_ClauseWhere = "WHERE " + m_CleUnique + " = {p_CleUniqueUrl}"
      FIN
      
      // ==============================================================================
      // 5. LE KILL-SWITCH ABSOLU : INTERDICTION DU "FULL UPDATE"
      // ==============================================================================
      SI SansEspace(l_ClauseWhere) = "" ALORS
      	m_erreur = "ALERTE SÉCURITÉ : Tentative d'UPDATE sans clause WHERE bloquée pour la table : " + m_NomTable
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(m_erreur, "", "SECURITE")
      	FIN
      	RENVOYER Faux
      FIN
      
      // S'il n'y a aucun champ à modifier (ex: JSON ne contenant que l'identifiant)
      SI SansEspace(l_CorpsReq) = "" ALORS
      	RENVOYER Vrai
      FIN
      
      // 6. Ouverture de la connexion isolée du thread
      SI PAS :Connexion() ALORS
      	m_erreur = "Erreur ORM : Impossible d'ouvrir la connexion base de données."
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(m_erreur, "", "CRITIQUE")
      	FIN
      	RENVOYER Faux
      FIN
      
      // 7. Assemblage et exécution
      m_RequeteSQL		= "UPDATE " + m_NomTable + RC + "SET " + RC + l_CorpsReq + RC + l_ClauseWhere
      
      l_SuccesExecution	= HExécuteRequêteSQL(l_SourceRequete, m_NomConnexion, hRequêteDéfaut, m_RequeteSQL)
      SI PAS l_SuccesExecution ALORS
      	m_erreur = HErreurInfo()
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Échec HExécuteRequêteSQL UPDATE sur '%1' : %2", m_NomTable, m_erreur), "", "ERREUR")
      	FIN
      SINON
      	// Invalidation directe du cache pour cette table
      	SI m_Cache <> Null ALORS
      		m_Cache.InvaliderRessource(m_NomBaseDonnees, m_NomTable)
      	FIN
      FIN
      
      RENVOYER l_SuccesExecution
      
      CAS ERREUR:
      m_erreur = HErreurInfo()
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Erreur d'exécution UPDATE sur la table '%1' : %2", m_NomTable, m_erreur), "", "ERREUR")
      FIN
      RENVOYER Faux
      
      CAS EXCEPTION:
      m_erreur = ExceptionInfo()
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Exception non interceptée lors de l'UPDATE sur '%1'", m_NomTable), "", "CRITIQUE", ExceptionInfo(errComplet))
      FIN
      RENVOYER Faux
      
      FIN :
      HAnnuleDéclaration(l_SourceRequete)
      :Déconnexion()
     type : 458752
   -
     name : Creer
     procedure_id : 1891210886552712128
     type_code : 12
     code : |1-
      procédure Creer()
      
      LOCAL
      	l_Enregistrement est un Enregistrement
      
      Connexion()
      HChangeConnexion({m_NomTable, indFichier}, m_NomConnexion)
      
      HRAZ(m_NomTable)
      {m_NomTable, indFichier} = _JsonVersEnregistrement()
      HAjoute(m_NomTable, hAffecteParcours)
      
      l_Enregistrement = {m_NomTable, indFichier}
      Sérialise(l_Enregistrement, m_json, psdJSON)
      
      // Invalidation directe du cache pour cette table
      SI m_Cache <> Null ALORS
      	m_Cache.InvaliderRessource(m_NomBaseDonnees, m_NomTable)
      FIN
      
      CAS ERREUR:
      Déconnexion()
      m_erreur = ErreurInfo()
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Erreur HFSQL Creer() sur la table '%1' : %2", m_NomTable, m_erreur), "", "ERREUR")
      FIN
      
      CAS EXCEPTION:
      Déconnexion()
      m_erreur = ExceptionInfo()
      SI m_Journal <> Null ALORS
      	m_Journal.EnregistrerErreur(ChaîneConstruit("Exception Creer() sur la table '%1'", m_NomTable), "", "CRITIQUE", ExceptionInfo(errComplet))
      FIN
      
      FIN :
      Déconnexion()
     type : 458752
   -
     name : _JsonVersEnregistrement
     procedure_id : 1891210886552777664
     type_code : 12
     code : |1+
      procédure privée _JsonVersEnregistrement() : Enregistrement
      
      LOCAL
      	l_VariantEnregistrement	est un Variant	= JSONVersVariant(m_json)
      	l_NouvelEnregistrement	est un Enregistrement
      	l_Indice				est un entier
      
      l_NouvelEnregistrement = {m_NomTable, indFichier}
      
      QUAND EXCEPTION DANS
      	POUR l_Indice = 1 _À_ l_VariantEnregistrement..Membre..Occurrence
      		{"l_NouvelEnregistrement." + l_VariantEnregistrement..Membre[l_Indice]..Nom} = l_VariantEnregistrement..Membre[l_Indice]..Valeur 	
      	FIN
      FAIRE
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Exception lors de la conversion JSON vers Enregistrement sur '%1'", m_NomTable), "", "ERREUR", ExceptionInfo(errComplet))
      	FIN
      FIN
      
      RENVOYER l_NouvelEnregistrement
     type : 458752
   -
     name : ChargerCollection
     procedure_id : 1897198161154489649
     type_code : 12
     code : |1+
      // Ajout du paramètre a_Operateur avec une valeur par défaut vide
      PROCEDURE ChargerCollection(a_RubriqueFiltre est une chaîne = "", a_ValeurFiltre est une chaîne = "", a_Operateur est une chaîne = "", a_IgnorerCache est un booléen = Faux)
      
      // Blindage de l'accès aux données contre les corruptions d'index ou verrous HFSQL
      QUAND EXCEPTION DANS
      	
      	LOCAL
      		l_SourceDonnees				est une Source de Données
      		l_RequeteSQL				est une chaîne
      		l_OperateurSql				est une chaîne	= Minuscule(a_Operateur)
      		l_TableauEnregistrements	est un tableau de Enregistrement
      		l_CacheJsonTrouve			est une chaîne	= ""
      		// CONDITIONS ET OPÉRATEURS PRIS EN CHARGE PAR L'API :
      		// -----------------------------------------------------------------------------------------
      		// 1. "contient"    -> Recherche partielle floue  (SQL: LIKE '%valeur%')
      		// 2. "commence"    -> Recherche par le début     (SQL: LIKE 'valeur%')
      		// 3. "termine"     -> Recherche par la fin       (SQL: LIKE '%valeur')
      		// 4. "sup"         -> Strictement supérieur      (SQL: > 'valeur')
      		// 5. "inf"         -> Strictement inférieur      (SQL: < 'valeur')
      		// 6. [Vide / Autre]-> Égalité stricte par défaut (SQL: = 'valeur')
      		// -----------------------------------------------------------------------------------------
      		
      	SI a_RubriqueFiltre <> "" ET a_ValeurFiltre <> "" ALORS
      		// Protection essentielle anti-injection SQL sur la valeur cliente
      		a_ValeurFiltre = Remplace(a_ValeurFiltre, "'", "''") 
      		
      		SELON l_OperateurSql
      			CAS "contient" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 LIKE '%3'", m_NomTable, a_RubriqueFiltre, "%" + a_ValeurFiltre + "%")
      			CAS "commence" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 LIKE '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre + "%")
      			CAS "termine" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 LIKE '%3'", m_NomTable, a_RubriqueFiltre, "%" + a_ValeurFiltre)
      			CAS "sup" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 > '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre)
      			CAS "inf" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 < '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre)
      			AUTRE CAS :
      				// Égalité stricte par défaut
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 = '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre)
      		FIN
      	SINON
      		// Aucun filtre, extraction complète de la ressource
      		l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1", m_NomTable)
      	FIN
      	
      	m_RequeteSQL = l_RequeteSQL
      	
      	// Contrôle du micro-cache SQL autonome
      	SI PAS a_IgnorerCache ET m_Cache <> Null ALORS
      		l_CacheJsonTrouve = m_Cache.ObtenirParSql(l_RequeteSQL)
      		SI l_CacheJsonTrouve <> "" ALORS
      			m_json   = l_CacheJsonTrouve
      			m_erreur = ""
      			RETOUR
      		FIN
      	FIN
      	
      	Connexion()
      	// Exécution SQL dans l'isolation du thread courant
      	SI HExécuteRequêteSQL(l_SourceDonnees, m_NomConnexion, hRequêteDéfaut, l_RequeteSQL) ALORS
      		FichierVersTableau(l_TableauEnregistrements, l_SourceDonnees)
      		Sérialise(l_TableauEnregistrements, m_json, psdJSON)
      		m_erreur = ""
      		
      		// Mémorisation dans le micro-cache
      		SI m_Cache <> Null ET m_json <> "" ALORS
      			m_Cache.MettreParSql(l_RequeteSQL, m_NomBaseDonnees, m_json)
      		FIN
      	SINON
      		m_erreur = "{""erreur"": ""Erreur d'exécution HFSQL : " + Remplace(HErreurInfo(hErrMessage), """", "\""") + """}"
      		SI m_Journal <> Null ALORS
      			m_Journal.EnregistrerErreur(ChaîneConstruit("Erreur ChargerCollection() sur '%1' : %2", m_NomTable, HErreurInfo(hErrComplet)), "", "ERREUR")
      		FIN
      	FIN
      	
      	HAnnuleDéclaration(l_SourceDonnees)
      	
      FAIRE
      	// Capture des ruptures de connexions ou crashs d'indirection
      	m_erreur = "{""erreur"": ""Le moteur de données a rencontré une exception fatale.""}"
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Exception ChargerCollection() sur '%1'", m_NomTable), "", "CRITIQUE", ExceptionInfo(errComplet))
      	FIN
      FIN
      
      Déconnexion()
     type : 458752
   -
     name : _GenererJsonDepuisSource
     procedure_id : 1897208443306296295
     type_code : 12
     code : |1+
      PROCEDURE PRIVÉE _GenererJsonDepuisSource(a_SourceDonnees est une Source de Données)
      
      LOCAL
      	l_ListeRubriques	est une chaîne
      	l_NomRubrique		est une chaîne
      	l_ValeurBrute		est une chaîne
      	l_JsonGenere		est une chaîne	= "{"
      	l_Premier			est un booléen	= Vrai
      	
      	// =================================================================================
      	// 1. INTROSPECTION DE LA STRUCTURE DE DONNÉES
      	// HListeRubrique renvoie les noms de toutes les colonnes de la requête, 
      	// séparés par des retours chariot (RC).
      	// =================================================================================
      l_ListeRubriques = HListeRubrique(a_SourceDonnees)
      
      // =================================================================================
      // 2. PARCOURS DYNAMIQUE ET SÉRIALISATION
      // =================================================================================
      POUR TOUTE CHAINE l_NomRubrique DE l_ListeRubriques SEPAREE PAR RC
      	
      	// Sécurité : ignorer les lignes vides éventuelles
      	SI l_NomRubrique = "" ALORS CONTINUER
      	
      	SI PAS l_Premier ALORS 
      		l_JsonGenere += ", "
      	FIN
      	
      	// ---------------------------------------------------------
      	// Lecture par Indirection WLangage
      	// L'utilisation des crochets permet d'extraire la valeur 
      	// physique sans connaître la table à l'avance.
      	// ---------------------------------------------------------
      	l_ValeurBrute = {a_SourceDonnees..Nom + "." + l_NomRubrique, indRubrique}	
      	// ---------------------------------------------------------
      	// Sécurisation stricte du format JSON (Échappement)
      	// Sans cela, un guillemet dans un nom de client casserait ton API.
      	// ---------------------------------------------------------
      	l_ValeurBrute	= Remplace(l_ValeurBrute, "\", "\\")   // Sécuriser l'antislash d'abord
      	l_ValeurBrute	= Remplace(l_ValeurBrute, """", "\""") // Sécuriser les guillemets
      	l_ValeurBrute	= Remplace(l_ValeurBrute, RC, "\n")    // Gérer les sauts de ligne multi-OS
      	l_ValeurBrute	= Remplace(l_ValeurBrute, TAB, "\t")   // Gérer les tabulations
      	
      	// ---------------------------------------------------------
      	// Construction de la paire "Clé": "Valeur"
      	// Choix architectural : Pour simplifier cette version manuelle, 
      	// toutes les valeurs sont castées en chaîne ("valeur").
      	// ---------------------------------------------------------
      	l_JsonGenere += ChaîneConstruit("""%1"": ""%2""", l_NomRubrique, l_ValeurBrute)
      	
      	l_Premier = Faux
      FIN
      
      l_JsonGenere += "}"
      
      // =================================================================================
      // 3. RETOUR DE L'OBJET JSON
      // =================================================================================
      RENVOYER l_JsonGenere
     type : 458752
   -
     name : SupprimerUnitaire
     procedure_id : 1897212175633155679
     type_code : 12
     code : |1+
      PROCEDURE SupprimerUnitaire(a_ValeurCleUnique est une chaîne)
      
      SI HLitRecherchePremier(m_NomTable, m_CleUnique, a_ValeurCleUnique) ALORS
      	SI HSupprime(m_NomTable) ALORS
      		m_erreur = ""
      		SI m_Cache <> Null ALORS
      			m_Cache.InvaliderRessource(m_NomBaseDonnees, m_NomTable)
      		FIN
      	SINON
      		m_erreur = "{""erreur"": ""Impossible de supprimer l'enregistrement : " + HErreurInfo(hErrMessage) + """}"
      		SI m_Journal <> Null ALORS
      			m_Journal.EnregistrerErreur(ChaîneConstruit("Échec de suppression sur '%1' (Clé: %2) : %3", m_NomTable, a_ValeurCleUnique, HErreurInfo(hErrComplet)), "", "ERREUR")
      		FIN
      	FIN
      SINON
      	m_erreur = "{""erreur"": ""Enregistrement introuvable avec la clé spécifiée.""}"
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Suppression impossible : Clé '%1' introuvable dans la table '%2'", a_ValeurCleUnique, m_NomTable), "", "AVERTISSEMENT")
      	FIN
      FIN
     type : 458752
   -
     name : SupprimerCollection
     procedure_id : 1897212283007428771
     type_code : 12
     code : |1+
      PROCEDURE SupprimerCollection(a_RubriqueFiltre est une chaîne, a_ValeurFiltre est une chaîne)
      
      LOCAL
      	l_RequeteSQL est une chaîne
      	
      SI a_RubriqueFiltre = "" OU a_ValeurFiltre = "" ALORS
      	m_erreur = "{""erreur"": ""Les paramètres 'rubrique' et 'valeur' sont obligatoires pour une suppression en masse.""}"
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("ALERTE SÉCURITÉ : Tentative de suppression en masse sans filtre sur la table '%1'", m_NomTable), "", "SECURITE")
      	FIN
      	RETOUR
      FIN
      
      a_ValeurFiltre	= Remplace(a_ValeurFiltre, "'", "''")
      l_RequeteSQL	= ChaîneConstruit("DELETE FROM %1 WHERE %2 = '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre)
      
      SI PAS HExécuteRequêteSQL(l_RequeteSQL) ALORS
      	m_erreur = "{""erreur"": ""Échec de la suppression en masse : " + HErreurInfo(hErrMessage) + """}"
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Échec de la suppression en masse sur '%1' : %2", m_NomTable, HErreurInfo(hErrComplet)), "", "ERREUR")
      	FIN
      SINON
      	m_erreur = ""
      	SI m_Cache <> Null ALORS
      		m_Cache.InvaliderRessource(m_NomBaseDonnees, m_NomTable)
      	FIN
      FIN
     type : 458752
   -
     name : ConfigurerAccesBdd
     procedure_id : 1917049530062857359
     type_code : 12
     code : |1+
      PROCÉDURE ConfigurerAccesBdd(a_Provider est une chaîne, a_Serveur est une chaîne, a_NomBase est une chaîne, a_Utilisateur est une chaîne, a_MotDePasse est une chaîne, a_Journal est CLJournalisation dynamique = Null)
      
      m_ProviderBdd		= SansEspace(a_Provider)
      m_ServeurBdd		= SansEspace(a_Serveur)
      m_NomBaseDonnees	= SansEspace(a_NomBase)
      m_UtilisateurBdd	= SansEspace(a_Utilisateur)
      m_MotDePasseBdd		= a_MotDePasse
      
      SI a_Journal <> Null ALORS
      	m_Journal = a_Journal
      FIN
     type : 458752
   -
     name : Connexion
     procedure_id : 1917049697566620903
     type_code : 12
     code : |1+
      PROCÉDURE Connexion() : booléen
      
      LOCAL
      	l_SuccesOuverture	est un booléen	= Faux
      	
      SI m_NomConnexion <> "" ALORS
      	Déconnexion()
      FIN
      
      m_NomConnexion = "CNX_" + m_NomTable + "_" + DonneGUID(guidBrut)
      HDécritConnexion(m_NomConnexion, m_UtilisateurBdd, m_MotDePasseBdd, m_ServeurBdd, m_NomBaseDonnees, m_ProviderBdd)
      l_SuccesOuverture = HOuvreConnexion(m_NomConnexion)
      
      SI PAS l_SuccesOuverture ALORS
      	SI m_Journal <> Null ALORS
      		m_Journal.EnregistrerErreur(ChaîneConstruit("Échec HOuvreConnexion pour la table '%1' [Connexion: %2]", m_NomTable, m_NomConnexion), "", "CRITIQUE", HErreurInfo(hErrComplet))
      	FIN
      	m_NomConnexion = ""
      	RENVOYER Faux
      FIN
      
      RENVOYER Vrai
     type : 458752
   -
     name : Déconnexion
     procedure_id : 1917051424143548012
     type_code : 12
     code : |1+
      PROCÉDURE Déconnexion()
      
      SI m_NomConnexion <> "" ALORS
      	HFermeConnexion(m_NomConnexion)
      	HAnnuleDéclaration(m_NomConnexion)
      	m_NomConnexion = ""
      FIN
     type : 458752
