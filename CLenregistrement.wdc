  p_codes :
   -
     code : |1+
      CLEnregistrement est une Classe
      	m_base						est un  CLBase
      	m_condition					est une chaîne 
      	m_erreur					est une chaîne 
      	m_json						est une chaîne	// Représentation JSON de l'entité active 
      	m_RequeteSQL				est une chaine	// Dernier code SQL exécuté par l'instance
      	m_NomTable					est une chaîne	// Nom physique de la table / fichier HFSQL manipulé
      	m_CleUnique					est une chaîne	// Nom de la colonne constituant la clé primaire unique identifiée
      	m_ValeurCle					est une chaîne	// Valeur active de la clé primaire de l'enregistrement chargé
      	
      	
      
      fin
      
     type : 131072
