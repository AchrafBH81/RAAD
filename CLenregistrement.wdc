   -
     name : Init
     internal_properties : BQAAAAUAAAAcLpBr0K4gYdokgggwYHq/YBDVaIPdjeR1VEo/vzFcOGRJ3cJSZZ8PG6l3iF2SwOIJ5Kz9k7gF+y7kHyJ9kOiyf4Gl6ZSxsH3J0o4OXMu3LZ/R6PhT8uLCOdoLDGeu/5VyBBzyGltKMtMa629WkCiEXPdkF9BB3bcZIms8d/TFHbUUK8MzJhfF8wS+fXWDR63qNdSJuQ==
     procedure_id : 1891210886552515520
     type_code : 12
     code : |1+
      procédure Init(a_table est une chaîne)
      
      // on initialise la classe avec le nom de la table 
      
      // Extraction de la structure de la table 
      
      m_NomTable = a_table
      indrub est un entier
      
      l_ResRub est une chaîne = HListeClé(m_NomTable,hLstDétailPlus)
      l_nomRub est une chaine  
      
      POUR TOUTE CHAÎNE l_rub DE l_ResRub SEPAREE PAR RC
      	
      	POUR TOUTE CHAÎNE l_desRub de l_rub SEPAREE PAR TAB
      		selon indrub
      			
      			cas 0 : l_nomRub = l_desRub
      			
      			cas 4 : SI Val(l_desRub) = 1  ALORS m_CleUnique = l_nomRub
      		FIN
      		
      		 
      		indrub++ 
      		si indrub = 5 ou m_CleUnique <> "" alors sortir 
      	FIN
      
      	si m_CleUnique <> "" ALORS SORTIR
      FIN
      //// déclaration dynamique de l'enregistrement 
      //Trace(m_enrg..FichierAssocié)
      //l_codeDynamique  est chaine = [
      //e_%1 est un Enregistrement de %1 
      //hlitpremier(wbarticle)
      //]
      //l_codeDynamique = ChaîneConstruit(l_codeDynamique,m_table)
      //
      //ExécuteCode(l_codeDynamique)
      
      
      
      CAS ERREUR:
      m_base.Déconnexion()
      m_erreur = ErreurInfo()
      
      
      
      CAS EXCEPTION:
      m_base.Déconnexion()
      m_erreur = ExceptionInfo()
      
     type : 458752
   -
     name : Charger
     procedure_id : 1891210886552581056
     type_code : 12
     code : |1-
      procédure Charger(local a_valkey est une chaîne, a_condition est une chaîne)
      
      m_ValeurCle	= a_valkey
      m_condition	= a_condition
      
      LOCAL
      	L_ReqSQL			est une source de données
      	L_ResEnregistrement	est un Enregistrement 
      	
      
      SI m_ValeurCle <> "" ALORS
      	m_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 where %2" , m_NomTable, m_CleUnique + " = " + m_ValeurCle )
      SINON
      	m_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 where %2" , m_NomTable, m_condition ) 
      FIN
      
      m_base.Connexion()
      HExécuteRequêteSQL(L_ReqSQL,m_base.m_connexion,hRequêteSansCorrection,m_RequeteSQL)
      // lire le premier enregistrement  
      HLitPremier(L_ReqSQL)
      FichierVersMémoire(L_ResEnregistrement,L_ReqSQL)
      HAnnuleDéclaration(L_ReqSQL)
      
      //Sérialisation de l’enregistrement 
      Sérialise(L_ResEnregistrement,m_json,psdJSON)
      
      
      CAS ERREUR:
      m_base.Déconnexion()
      m_erreur = ErreurInfo()
      
      
      
      CAS EXCEPTION:
      m_base.Déconnexion()
      m_erreur = ExceptionInfo()
      
      
      FIN :
      m_base.Déconnexion()
     type : 458752
   -
     name : Modifier
     procedure_id : 1891210886552646592
     type_code : 12
     code : |1+
      
      
      procédure Modifier()
      // [ARCHITECTURE RAAD : SÉCURITÉ ANTI-INJECTION SQL]
      // RÈGLE ABSOLUE : Zéro concaténation de valeurs clientes dans les requêtes SQL.
      // Nous utilisons une variable de type 'Source de Données' couplée à hRequêteDéfaut.
      // L'affectation dynamique des paramètres se fait via indirection : 
      // {"MaSource.MonParametre"} = Valeur. Le moteur HFSQL gère le typage et l'échappement.
      
      
      LOCAL
      	l_SourceRequete		est une Source de Données
      	l_DonneesJson		est un Variant
      	l_ClauseWhere		est une chaîne
      	l_CorpsReq			est une chaîne
      	l_NomParametre		est une chaîne
      	
      // 1. Initialisation et Connexion
      m_base.Connexion()
      
      l_DonneesJson	= JSONVersVariant(m_json)
      
      // 2. Construction de l'ossature SQL paramétrée
      m_RequeteSQL	= "UPDATE " + m_NomTable + RC + "SET "
      
      POUR TOUT l_Ligne DE l_DonneesJson
      	
      	// Création d'un nom de paramètre unique (ex: p_Prix)
      	l_NomParametre = "p_" + l_Ligne..Nom
      	
      	SI l_Ligne..Nom = m_CleUnique ALORS
      		l_ClauseWhere = "WHERE " + l_Ligne..Nom + " = {" + l_NomParametre + "}"
      	SINON
      		// Ajoute automatiquement la virgule si l_CorpsReq n'est pas vide
      		l_CorpsReq += [", " + RC] + l_Ligne..Nom + " = {" + l_NomParametre + "}"
      	FIN
      	
      	// 3. SECRÉTAIRE ANTI-INJECTION : Affectation de la valeur en tant que PARAMÈTRE
      	// L'indirection crée la propriété de paramètre à la volée sur la source de données.
      	// Équivaut à taper : l_SourceRequete.p_Prix = 10
      	{"l_SourceRequete." + l_NomParametre} = l_Ligne..Valeur
      FIN
      
      // 4. Assemblage final de la requête SQL paramétrée
      m_RequeteSQL += RC + l_CorpsReq + RC + l_ClauseWhere
      
      // 5. Exécution sécurisée
      // La constante hRequêteDéfaut indique à HFSQL d'analyser la chaîne, d'y repérer 
      // les variables {...} et de les lier aux paramètres affectés à l_SourceRequete.
      SI PAS HExécuteRequêteSQL(l_SourceRequete, m_base.m_connexion, hRequêteDéfaut, m_RequeteSQL) ALORS
      	m_erreur = ErreurInfo()
      FIN
      
      
      CAS ERREUR:
      m_erreur = ErreurInfo()
      
      CAS EXCEPTION:
      m_erreur = ExceptionInfo()
      
      FIN :
      // Exécuté dans tous les cas
      m_base.Déconnexion()
     type : 458752
   -
     name : Creer
     procedure_id : 1891210886552712128
     type_code : 12
     code : |1-
      procédure Creer()
      
      HRAZ(m_NomTable)
      {m_NomTable,indFichier} = _JsonVersEnregistrement()
      HAjoute(m_NomTable,hAffecteParcours)
      
      l_enrg est un Enregistrement = {m_NomTable,indFichier}
      Sérialise(l_enrg,m_json,psdJSON)
      
      
      CAS ERREUR:
      m_base.Déconnexion()
      m_erreur = ErreurInfo()
      
      
      
      CAS EXCEPTION:
      m_base.Déconnexion()
      m_erreur = ExceptionInfo()
      
      
      FIN :
      m_base.Déconnexion()
     type : 458752
   -
     name : _JsonVersEnregistrement
     procedure_id : 1891210886552777664
     type_code : 12
     code : |1+
      procédure privée _JsonVersEnregistrement():Enregistrement
      
      VariantEnregistrement		est un variant	= JSONVersVariant(m_json)
      NouvelEnregistrement	est un Enregistrement
      NouvelEnregistrement = {m_NomTable}
      
      POUR i=1 _a_ VariantEnregistrement..Membre..Occurrence
      	{"E_record."+VariantEnregistrement..Membre[i]..Nom} = VariantEnregistrement..Membre[i]..Valeur 	
      FIN
      
      renvoyer NouvelEnregistrement
     type : 458752
   -
     name : ChargerCollection
     procedure_id : 1897198161154489649
     type_code : 12
     code : |1-
      // Ajout du paramètre a_Operateur avec une valeur par défaut vide
      PROCEDURE ChargerCollection(a_RubriqueFiltre est une chaîne = "", a_ValeurFiltre est une chaîne = "", a_Operateur est une chaîne = "")
      
      // Blindage de l'accès aux données contre les corruptions d'index ou verrous HFSQL
      QUAND EXCEPTION DANS
      	
      	LOCAL
      		l_SourceDonnees				est une Source de Données
      		l_RequeteSQL				est une chaîne
      		l_VariantTableau			est un tableau de variants
      		l_VariantLigne				est un variant
      		l_OperateurSql				est une chaîne	= Minuscule(a_Operateur)
      		l_tableauEnregistrements	est un tableau de Enregistrement
      		// CONDITIONS ET OPÉRATEURS PRIS EN CHARGE PAR L'API :
      		// -----------------------------------------------------------------------------------------
      		// 1. "contient"    -> Recherche partielle floue  (SQL: LIKE '%valeur%')
      		// 2. "commence"    -> Recherche par le début     (SQL: LIKE 'valeur%')
      		// 3. "termine"     -> Recherche par la fin       (SQL: LIKE '%valeur')
      		// 4. "sup"         -> Strictement supérieur      (SQL: > 'valeur')
      		// 5. "inf"         -> Strictement inférieur      (SQL: < 'valeur')
      		// 6. [Vide / Autre]-> Égalité stricte par défaut (SQL: = 'valeur')
      		// -----------------------------------------------------------------------------------------
      		
      	SI a_RubriqueFiltre <> "" ET a_ValeurFiltre <> "" ALORS
      		// Protection essentielle anti-injection SQL sur la valeur cliente
      		a_ValeurFiltre = Remplace(a_ValeurFiltre, "'", "''") 
      		
      		SELON l_OperateurSql
      			CAS "contient" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 LIKE '%3'", m_NomTable, a_RubriqueFiltre, "%" + a_ValeurFiltre + "%")
      			CAS "commence" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 LIKE '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre + "%")
      			CAS "termine" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 LIKE '%3'", m_NomTable, a_RubriqueFiltre, "%" + a_ValeurFiltre)
      			CAS "sup" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 > '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre)
      			CAS "inf" :
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 < '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre)
      			AUTRE CAS :
      				// Égalité stricte par défaut
      				l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1 WHERE %2 = '%3'", m_NomTable, a_RubriqueFiltre, a_ValeurFiltre)
      		FIN
      	SINON
      		// Aucun filtre, extraction complète de la ressource
      		l_RequeteSQL = ChaîneConstruit("SELECT * FROM %1", m_NomTable)
      	FIN
      	
      	// Exécution SQL dans l'isolation du thread courant
      	SI HExécuteRequêteSQL(l_SourceDonnees, hRequêteDéfaut, l_RequeteSQL) ALORS
      //		POUR TOUT l_SourceDonnees
      //			l_VariantLigne = l_SourceDonnees
      //			TableauAjoute(l_VariantTableau, l_VariantLigne)
      //		FIN
      //		m_json		= VariantVersJSON(l_VariantTableau)
      		FichierVersTableau(l_tableauEnregistrements,l_SourceDonnees)
      		Sérialise(l_tableauEnregistrements,m_json,psdJSON)
      		m_erreur	= ""
      	SINON
      		m_erreur = "{""erreur"": ""Erreur d'exécution HFSQL : " + Remplace(HErreurInfo(hErrMessage), """", "\""") + """}"
      	FIN
      	
      	HAnnuleDéclaration(l_SourceDonnees)
      	
      FAIRE
      	// Capture des ruptures de connexions ou crashs d'indirection
      	m_erreur = "{""erreur"": ""Le moteur de données a rencontré une exception fatale.""}"
      FIN
     type : 458752
   -
     name : _GenererJsonDepuisSource
     procedure_id : 1897208443306296295
     type_code : 12
     code : |1+
      PROCEDURE PRIVÉE _GenererJsonDepuisSource(a_SourceDonnees est une Source de Données)
      
      LOCAL
      	l_ListeRubriques	est une chaîne
      	l_NomRubrique		est une chaîne
      	l_ValeurBrute		est une chaîne
      	l_JsonGenere		est une chaîne	= "{"
      	l_Premier			est un booléen	= Vrai
      	
      	// =================================================================================
      	// 1. INTROSPECTION DE LA STRUCTURE DE DONNÉES
      	// HListeRubrique renvoie les noms de toutes les colonnes de la requête, 
      	// séparés par des retours chariot (RC).
      // =================================================================================
      l_ListeRubriques = HListeRubrique(a_SourceDonnees)
      
      // =================================================================================
      // 2. PARCOURS DYNAMIQUE ET SÉRIALISATION
      // =================================================================================
      POUR TOUTE CHAINE l_NomRubrique DE l_ListeRubriques SEPAREE PAR RC
      	
      	// Sécurité : ignorer les lignes vides éventuelles
      	SI l_NomRubrique = "" ALORS CONTINUER
      	
      	SI PAS l_Premier ALORS 
      		l_JsonGenere += ", "
      	FIN
      	
      	// ---------------------------------------------------------
      	// Lecture par Indirection WLangage
      	// L'utilisation des crochets permet d'extraire la valeur 
      	// physique sans connaître la table à l'avance.
      	// ---------------------------------------------------------
      	l_ValeurBrute = {a_SourceDonnees..Nom + "." + l_NomRubrique, indRubrique}	
      	// ---------------------------------------------------------
      	// Sécurisation stricte du format JSON (Échappement)
      	// Sans cela, un guillemet dans un nom de client casserait ton API.
      	// ---------------------------------------------------------
      	l_ValeurBrute	= Remplace(l_ValeurBrute, "\", "\\")   // Sécuriser l'antislash d'abord
      	l_ValeurBrute	= Remplace(l_ValeurBrute, """", "\""") // Sécuriser les guillemets
      	l_ValeurBrute	= Remplace(l_ValeurBrute, RC, "\n")    // Gérer les sauts de ligne multi-OS
      	l_ValeurBrute	= Remplace(l_ValeurBrute, TAB, "\t")   // Gérer les tabulations
      	
      	// ---------------------------------------------------------
      	// Construction de la paire "Clé": "Valeur"
      	// Choix architectural : Pour simplifier cette version manuelle, 
      	// toutes les valeurs sont castées en chaîne ("valeur").
      	// ---------------------------------------------------------
      	l_JsonGenere += ChaîneConstruit("""%1"": ""%2""", l_NomRubrique, l_ValeurBrute)
      	
      	l_Premier = Faux
      FIN
      
      l_JsonGenere += "}"
      
      // =================================================================================
      // 3. RETOUR DE L'OBJET JSON
      // =================================================================================
      renvoyer l_JsonGenere
     type : 458752
   -
     name : SupprimerUnitaire
     procedure_id : 1897212175633155679
     type_code : 12
     code : |1+
      PROCEDURE SupprimerUnitaire(a_ValeurCleUnique est une chaîne)
      
      // 1. Recherche de l'enregistrement en base de données
      // m_NomTable contient le nom de la table, m_CleUnique contient le nom de la clé primaire
      SI HLitRecherchePremier(m_NomTable, m_CleUnique, a_ValeurCleUnique) ALORS
      	
      	// 2. Suppression physique
      	SI HSupprime(m_NomTable) ALORS
      		m_erreur = ""
      	SINON
      		m_erreur = "{""erreur"": ""Impossible de supprimer l'enregistrement : " + HErreurInfo(hErrMessage) + """}"
      	FIN
      SINON
      	m_erreur = "{""erreur"": ""Enregistrement introuvable avec la clé spécifiée.""}"
      FIN
      
     type : 458752
   -
     name : SupprimerCollection
     procedure_id : 1897212283007428771
     type_code : 12
     code : |1+
      PROCEDURE SupprimerCollection(a_RubriqueFiltre est une chaîne, a_ValeurFiltre est une chaîne)
      
      LOCAL
      	l_RequeteSQL est une chaîne
      	
      // 1. Validation de sécurité : les filtres doivent être fournis pour éviter un DELETE global accidentel !
      SI a_RubriqueFiltre = "" OU a_ValeurFiltre = "" ALORS
      	m_erreur = "{""erreur"": ""Les paramètres 'rubrique' et 'valeur' sont obligatoires pour une suppression en masse.""}"
      	RETOUR
      FIN
      
      // 2. Sécurisation anti-injection SQL sur la valeur (Échappement WinDev 25)
      a_ValeurFiltre	= Remplace(a_ValeurFiltre, "'", "''")
      
      // 3. Construction de la requête de suppression en masse
      l_RequeteSQL	= ChaîneConstruit("DELETE FROM %1 WHERE %2 = '%3'", ...
      m_NomTable, a_RubriqueFiltre, a_ValeurFiltre)
      
      // 4. Exécution directe de la requête de modification/suppression
      // En WinDev 25, HExécuteRequêteSQL sans Source de Données exécute l'ordre directement en C/S
      SI PAS HExécuteRequêteSQL(l_RequeteSQL) ALORS
      	m_erreur = "{""erreur"": ""Échec de la suppression en masse : " + HErreurInfo(hErrMessage) + """}"
      SINON
      	m_erreur = ""
      FIN
      
     type : 458752
